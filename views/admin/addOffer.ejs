<%- include('../partials/header') %>
<head>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts for standard clean typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<div class="page-container">
    <header class="page-header">
        <h1>Add Offer</h1>
        <p>Create a new offer or update an existing one.</p>
    </header>

    <!-- Modified action to match your backend route -->
    <form class="offer-form" action="/admin/offers/add" method="POST">
        <div class="card">
            
            <!-- Card Header -->
            <div class="card-header">
                <div class="header-icon">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div class="header-text">
                    <h2>Offer Details</h2>
                    <p>Fill in the information below to create or edit an offer.</p>
                </div>
            </div>

            <!-- Card Body / Form Fields -->
            <div class="card-body">
                <div class="form-grid">
                    
                    <!-- Row 1 -->
                    <div class="form-group">
                        <label>Offer Name <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <!-- Updated name to "name" to match backend -->
                            <input type="text" name="name" placeholder="Enter offer name" required>
                            <i class="fa-regular fa-keyboard input-icon"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Discount % <span class="required">*</span></label>
                        <div class="input-wrapper input-wrapper-group">
                            <!-- Updated name to "discountPercentage" to match backend -->
                            <input type="number" name="discountPercentage" placeholder="Enter discount percentage" required>
                            <span class="input-suffix">%</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Select Product / Category <span class="required">*</span></label>
                        <!-- Added ID for JavaScript -->
                        <select name="type" id="offerType" required>
                            <option value="product" selected>Product</option>
                            <option value="category">Category</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label id="dynamicLabel">Select Product Name <span class="required">*</span></label>
                        <!-- Added ID for JavaScript, initial name set to productRef -->
                        <select name="productRef" id="dynamicSelect" required>
                            <option value="" disabled selected>Select product...</option>
                            <!-- Options will be injected by JavaScript -->
                        </select>
                    </div>

<!-- Row 2 -->
                    <div class="form-group">
                        <label>Start Date <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input 
                                type="date" 
                                name="startDate" 
                                id="startDate"
                                required 
                                style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;"
                            >
                        </div>
                    </div>

                    <div class="form-group">
                        <label>End Date (Expiry) <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input 
                                type="date" 
                                name="expiryDate" 
                                id="expiryDate"
                                required 
                                style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;"
                            >
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Status <span class="required">*</span></label>
                        <!-- Updated name to "isActive" -->
                        <select name="isActive" required>
                            <option value="true" selected>Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>

                </div> <!-- End Grid -->

                <!-- Row 3: Full Width -->
                <div class="form-group full-width mt-4">
                    <label>Description</label>
                    <textarea name="description" rows="3" placeholder="Enter offer description (optional)"></textarea>
                    <div class="char-count">0 / 200</div>
                </div>

            </div> <!-- End Card Body -->

            <!-- Card Footer -->
            <div class="card-footer">
                <button type="reset" class="btn btn-outline">
                    <i class="fa-solid fa-rotate-right"></i> Reset
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-regular fa-floppy-disk"></i> Save Offer
                </button>
            </div>

        </div>
    </form>
</div>

<!-- INJECT DYNAMIC DATA FOR EXTERNAL JS FILE -->
<script>
    // Pass the server-side data to the client-side window object safely
    window.offerData = {
        products: <%- JSON.stringify(products || []) %>,
        categories: <%- JSON.stringify(categories || []) %>
    };
</script>

<!-- Link to your new separated JS file -->
<script src="/js/addOffers.js"></script>
</body>
<%- include('../partials/footer') %>