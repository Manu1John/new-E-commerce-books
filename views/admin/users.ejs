<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/adminLayout.css">
<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1>
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
            <li><a href="/admin/users" class="active"><i class="fa-solid fa-users"></i> Users</a></li>
            <li><a href="/admin/sales-report"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li>
            <li><a href="/admin/offers"><i class="fa-solid fa-tags"></i> Offers</a></li>
            <li><a href="/admin/coupons"><i class="fa-solid fa-ticket"></i> Coupons</a></li>
            <li><a href="/admin/category"><i class="fa-solid fa-list"></i> Categories</a></li>
            <li class="logout-item">
                <form action="/admin/logout" method="POST">
                    <button class="logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        
        <!-- Breadcrumb & Header Section -->
        <div class="page-header-wrapper">
            <div>
                <nav aria-label="breadcrumb" class="breadcrumb-nav">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard">Dashboard</a></li>
                        <li class="active">User Management</li>
                    </ol>
                </nav>
                <h2 class="page-title">Users Directory</h2>
                <p class="text-muted mb-0">Manage customer accounts, statuses, and permissions. (Total: <%= totalUsers %>)</p>
            </div>
            
            <!-- Search Box -->
            <div class="search-wrapper">
                <form action="/admin/users" method="GET" id="searchForm" class="search-form">
                    <div class="search-input-group">
                        <i class="fa fa-search search-icon"></i>
                        <input type="text" id="searchInput" name="search" placeholder="Search by name or email..." value="<%= search || '' %>">
                        <% if(search) { %>
                            <a href="/admin/users" class="clear-search-btn" title="Clear Search"><i class="fa-solid fa-xmark"></i></a>
                        <% } %>
                    </div>
                    <button type="submit" class="btn-primary-pill">Search</button>
                </form>
            </div>
        </div>

        <!-- Users Table -->
        <div class="table-custom-wrapper mt-4">
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Customer Name</th>
                            <th>Email Address</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(users && users.length > 0) { %>
                            <% users.forEach((user, index) => { %>
                            <tr>
                                <td class="text-muted fw-bold">#<%= ((currentPage - 1) * limit) + index + 1 %></td>
                                <td>
                                    <div class="user-name-cell">
                                        <div class="user-avatar">
                                            <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName ? user.lastName.charAt(0).toUpperCase() : '' %>
                                        </div>
                                        <span class="fw-bold"><%= user.firstName %> <%= user.lastName %></span>
                                    </div>
                                </td>
                                <td><%= user.email %></td>
                                <td>
                                    <span class="badge <%= user.isBlocked ? 'badge-danger' : 'badge-success' %>">
                                        <i class="fa-solid <%= user.isBlocked ? 'fa-lock' : 'fa-check-circle' %> me-1"></i>
                                        <%= user.isBlocked ? "Blocked" : "Active" %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <% if(user.isBlocked) { %>
                                        <form action="/admin/user/<%= user.id %>/unblock?_method=PATCH" method="POST" class="status-form d-inline">
                                            <button type="button" class="action-btn btn-unblock" data-name="<%= user.firstName %>" data-action="unblock">
                                                <i class="fa-solid fa-unlock"></i> Unblock
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <form action="/admin/user/<%= user.id %>/block?_method=PATCH" method="POST" class="status-form d-inline">
                                            <button type="button" class="action-btn btn-block" data-name="<%= user.firstName %>" data-action="block">
                                                <i class="fa-solid fa-ban"></i> Block
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-users-slash fs-1 mb-3 d-block"></i>
                                    No users found matching your criteria.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if(totalPages > 1) { %>
        <div class="pagination-wrapper mt-4">
            <div class="pagination-custom">
                <% if(currentPage > 1) { %>
                    <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>" class="page-link prev-next">
                        <i class="fa-solid fa-chevron-left"></i> Prev
                    </a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/admin/users?page=<%= i %>&search=<%= search %>" class="page-link <%= currentPage === i ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
                
                <% if(currentPage < totalPages) { %>
                    <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>" class="page-link prev-next">
                        Next <i class="fa-solid fa-chevron-right"></i>
                    </a>
                <% } %>
            </div>
        </div>
        <% } %>

    </main>
</div>

<%- include('../partials/footer') %>
