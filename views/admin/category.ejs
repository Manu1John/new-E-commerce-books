<%- include('../partials/header') %>
<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1>
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
            <li><a href="/admin/users"><i class="fa-solid fa-users"></i> Users</a></li>
            <li><a href="/admin/sales-report"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li>
            <li><a href="/admin/offers"><i class="fa-solid fa-tags"></i> Offers</a></li>
            <li><a href="/admin/coupons"><i class="fa-solid fa-ticket"></i> Coupons</a></li>
            <li><a href="/admin/category" class="active"><i class="fa-solid fa-list"></i> Categories</a></li>
            <li class="logout-item">
                <form action="/admin/logout" method="POST">
                    <button class="logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        
        <!-- Breadcrumb & Header Section -->
        <div class="page-header-wrapper">
            <div>
                <nav aria-label="breadcrumb" class="breadcrumb-nav">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard">Dashboard</a></li>
                        <li class="active">Category Management</li>
                    </ol>
                </nav>
                <h2 class="page-title">Categories</h2>
                <p class="text-muted mb-0">Manage product categories and collections. (Total: <%= totalCategories %>)</p>
            </div>
            
            <div class="header-actions">
                <a href="/admin/category/add" class="btn-primary-pill"><i class="fa-solid fa-plus me-1"></i> Add New Category</a>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="search-container mt-4">
            <form action="/admin/category" method="GET" id="searchForm" class="search-form">
                <div class="search-input-group">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text" name="search" id="searchInput" placeholder="Search by Category..." value="<%= search || '' %>">
                    <% if(search) { %>
                        <button type="button" class="clear-search-btn" title="Clear Search" onclick="window.location.href='/admin/category'">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Categories Table -->
        <div class="table-custom-wrapper mt-4">
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(cat && cat.length > 0) { %>
                            <% cat.forEach((category, index) => { %>
                            <tr>
                                <td class="text-muted fw-bold">#<%= (currentPage - 1) * limit + index + 1 %></td>
                                <td>
                                    <span class="fw-bold"><i class="fa-solid fa-folder me-2 text-primary"></i> <%= category.name %></span>
                                </td>
                                <td>
                                    <span class="text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                        <%= category.description %>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge <%= category.status === 'active' || category.status === 'Active' ? 'badge-success' : 'badge-danger' %>">
                                        <%= category.status %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a href="/admin/category/<%= category._id %>/edit" class="action-btn btn-edit" title="Edit Category">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button type="button" class="action-btn btn-delete delete-category-btn" data-id="<%= category._id %>" title="Delete Category">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fs-1 mb-3 d-block"></i>
                                    No categories found matching your criteria.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if(totalPages > 1) { %>
        <div class="pagination-wrapper mt-4">
            <div class="pagination-custom">
                <% if(currentPage > 1) { %>
                    <a href="/admin/category?page=<%= currentPage - 1 %>&search=<%= search || '' %>" class="page-link prev-next">
                        <i class="fa-solid fa-chevron-left"></i> Prev
                    </a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/admin/category?page=<%= i %>&search=<%= search || '' %>" class="page-link <%= currentPage === i ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
                
                <% if(currentPage < totalPages) { %>
                    <a href="/admin/category?page=<%= currentPage + 1 %>&search=<%= search || '' %>" class="page-link prev-next">
                        Next <i class="fa-solid fa-chevron-right"></i>
                    </a>
                <% } %>
            </div>
        </div>
        <% } %>

    </main>
</div>

<script src="/js/category.js"></script>

<%- include('../partials/footer') %>