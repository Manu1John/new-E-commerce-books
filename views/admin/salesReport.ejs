<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/adminLayout.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1>
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
            <li><a href="/admin/users"><i class="fa-solid fa-users"></i> Users</a></li>
            <li><a href="/admin/sales-report" class="active"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li>
            <li><a href="/admin/offers"><i class="fa-solid fa-tags"></i> Offers</a></li>
            <li><a href="/admin/coupons"><i class="fa-solid fa-ticket"></i> Coupons</a></li>
            <li><a href="/admin/category"><i class="fa-solid fa-list"></i> Categories</a></li>
            <li class="logout-item">
                <form action="/admin/logout" method="POST">
                    <button class="logout-btn" type="submit"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                </form>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        <nav aria-label="breadcrumb" class="breadcrumb-nav">
            <ol class="breadcrumb">
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li class="active">Analytics & Reports</li>
            </ol>
        </nav>

        <h2 class="page-title mb-4">Analytics & Reports</h2>

        <!-- KPI Summary Cards -->
        <div class="stats-grid mb-4">
            <div class="card-custom">
                <div class="card-title-small">Total Orders</div>
                <h3 class="card-value"><%= summary.salesCount %></h3>
            </div>
            <div class="card-custom">
                <div class="card-title-small">Total Revenue</div>
                <h3 class="card-value text-success">₹<%= summary.totalSales.toFixed(2) %></h3>
            </div>
            <div class="card-custom">
                <div class="card-title-small">Total Offer Discounts</div>
                <h3 class="card-value text-danger">₹<%= summary.totalDiscounts.toFixed(2) %></h3>
            </div>
            <div class="card-custom">
                <div class="card-title-small">Coupon Deductions</div>
                <h3 class="card-value text-warning">₹<%= summary.totalCoupons.toFixed(2) %></h3>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-wrapper card-custom mb-4">
            <label class="filter-label">Filter Sales Data</label>
            <form action="/admin/sales-report" method="GET" id="filterForm" class="filter-form">
                <select name="filter" id="filterType" class="form-select-custom" onchange="toggleCustomDates()">
                    <option value="all" <%= filter === 'all' ? 'selected' : '' %>>All Time</option>
                    <option value="daily" <%= filter === 'daily' ? 'selected' : '' %>>Today</option>
                    <option value="weekly" <%= filter === 'weekly' ? 'selected' : '' %>>Last 7 Days</option>
                    <option value="yearly" <%= filter === 'yearly' ? 'selected' : '' %>>Last 1 Year</option>
                    <option value="custom" <%= filter === 'custom' ? 'selected' : '' %>>Custom Range</option>
                </select>

                <div class="custom-dates <%= filter === 'custom' ? '' : 'hidden' %>" id="customDateInputs">
                    <input type="date" name="startDate" class="form-control-custom" value="<%= startDate || '' %>">
                    <span class="to-text">to</span>
                    <input type="date" name="endDate" class="form-control-custom" value="<%= endDate || '' %>">
                </div>
                
                <input type="hidden" name="ordersSearch" value="<%= ordersSearch %>">
                <input type="hidden" name="catSearch" value="<%= catSearch %>">
                <input type="hidden" name="ordersPage" value="1">
                <input type="hidden" name="catPage" value="1">

                <div class="filter-actions">
                    <button type="submit" class="btn-primary-pill">Apply Filter</button>
                    <a href="/admin/sales-report" class="btn-outline-pill">Reset</a>
                </div>
            </form>
        </div>

        <!-- Detailed Sales Table -->
        <div class="table-custom-wrapper mb-5">
            <div class="sales-report-header d-flex flex-wrap justify-content-between align-items-center mb-3">
                <h5 class="m-0">Detailed Sales Report</h5>
                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    
                    <!-- Orders Search Form with Clear Button -->
                    <form action="/admin/sales-report" method="GET" class="d-flex">
                        <input type="hidden" name="filter" value="<%= filter %>">
                        <input type="hidden" name="startDate" value="<%= startDate || '' %>">
                        <input type="hidden" name="endDate" value="<%= endDate || '' %>">
                        <input type="hidden" name="catSearch" value="<%= catSearch %>">
                        <input type="hidden" name="catPage" value="<%= catCurrentPage %>">
                        
                        <div class="input-group input-group-sm">
                            <input type="text" name="ordersSearch" class="form-control" placeholder="Search orders..." value="<%= ordersSearch %>">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                            <!-- Clear button appears only if there is an active search -->
                            <% if (ordersSearch) { %>
                                <a href="/admin/sales-report?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&catSearch=<%= catSearch %>&catPage=<%= catCurrentPage %>" class="btn btn-secondary text-white" title="Clear Search">
                                    <i class="fas fa-times"></i>
                                </a>
                            <% } %>
                        </div>
                    </form>

                    <div class="sales-report-actions ms-2">
                        <a href="/admin/sales-report/excel?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>" class="btn-download excel-btn">
                            <i class="fas fa-file-excel"></i> Excel
                        </a>
                        <a href="/admin/sales-report/pdf?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>" class="btn-download pdf-btn">
                            <i class="fas fa-file-pdf"></i> PDF
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Products</th>
                            <th>Payment Method</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(orders && orders.length > 0) { %>
                            <% orders.forEach(order => { %>
                                <tr>
                                    <td class="text-nowrap"><%= order.createdAt.toLocaleDateString() %></td>
                                    <td class="fw-bold">#<%= order.orderId ? order.orderId.toString().slice(-6).toUpperCase() : order._id.toString().slice(-6).toUpperCase() %></td>
                                    <td><%= order.user ? order.user.email : 'Guest' %></td>
                                    <td>
                                        <% order.items.forEach((item) => { %>
                                            <div class="product-sm-text">
                                                <%= item.product ? item.product.title : 'Unknown Product' %> <span class="text-muted">(x<%= item.quantity %>)</span>
                                            </div>
                                        <% }) %>
                                    </td>
                                    <td>
                                        <span class="badge <%= order.paymentMethod === 'COD' ? 'bg-cod' : 'bg-online' %>">
                                            <%= order.paymentMethod %>
                                        </span>
                                    </td>
                                    <td class="fw-bold">₹<%= order.finalAmount.toFixed(2) %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="6" class="text-center py-4 text-muted">No orders match your search.</td></tr>
                        <% } %>
                    </tbody>
                </table>
                
                <% if (ordersTotalPages >= 1) { %>
                <nav aria-label="Orders Page navigation" class="mt-3">
                    <ul class="pagination justify-content-end">
                        <li class="page-item <%= ordersCurrentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= ordersCurrentPage - 1 %>&catPage=<%= catCurrentPage %>">Previous</a>
                        </li>
                        <% for(let i = 1; i <= ordersTotalPages; i++) { %>
                            <li class="page-item <%= i === ordersCurrentPage ? 'active' : '' %>">
                                <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= i %>&catPage=<%= catCurrentPage %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= ordersCurrentPage === ordersTotalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= ordersCurrentPage + 1 %>&catPage=<%= catCurrentPage %>">Next</a>
                        </li>
                    </ul>
                </nav>
                <% } %>
            </div>
        </div>

        <h4 class="section-divider-title mb-4">Analytics Dashboard</h4>
        
        <div class="charts-grid mb-4">
            <div class="card-custom">
                <h5 class="chart-header">Monthly Revenue</h5>
                <div class="chart-container"><canvas id="lineChart"></canvas></div>
            </div>
            <div class="card-custom">
                <h5 class="chart-header">Order Status</h5>
                <div class="chart-container"><canvas id="donutChart"></canvas></div>
            </div>
        </div>

        <div class="insights-grid mb-4">
            <div class="table-custom-wrapper m-0">
                <div class="sales-report-header"><h5>Best Customers</h5></div>
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead><tr><th>User ID</th><th>Customer Name</th><th>Total Orders</th><th>Total Spend</th></tr></thead>
                        <tbody>
                            <% if(bestCustomers && bestCustomers.length > 0) { %>
                                <% bestCustomers.forEach((customer) => { %>
                                <tr>
                                    <td class="fw-bold">#<%= customer.userId.toString().slice(-6).toUpperCase() %></td>
                                    <td><%= customer.firstName || customer.name || customer.email.split('@')[0] %> <%= customer.lastName || '' %></td>
                                    <td><span class="badge bg-neutral"><%= customer.totalOrders %></span></td>
                                    <td class="fw-bold text-success">₹<%= customer.totalAmount.toFixed(2) %></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" class="text-center py-4 text-muted">No customer data available for this period.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="highlight-wrapper">
                <div class="highlight-card">
                    <h5 class="highlight-title">Most Ordered Category</h5>
                    <% if (categoryPerformance && categoryPerformance.length > 0) { %>
                        <div class="highlight-content">📚 <%= categoryPerformance[0].categoryName %></div>
                        <div class="highlight-sub">Orders: <%= categoryPerformance[0].totalOrders %>+</div>
                    <% } else { %>
                        <div class="highlight-content text-muted" style="color: #cbd5e1 !important;">No Data Available</div>
                        <div class="highlight-sub">Orders: 0</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Category Performance Table -->
        <div class="table-custom-wrapper mb-5">
            <div class="sales-report-header d-flex flex-wrap justify-content-between align-items-center mb-3">
                <h5 class="m-0">Category Performance Breakdown</h5>
                
                <!-- Category Search Form with Clear Button -->
                <form action="/admin/sales-report" method="GET" class="d-flex mt-2 mt-md-0">
                    <input type="hidden" name="filter" value="<%= filter %>">
                    <input type="hidden" name="startDate" value="<%= startDate || '' %>">
                    <input type="hidden" name="endDate" value="<%= endDate || '' %>">
                    <input type="hidden" name="ordersSearch" value="<%= ordersSearch %>">
                    <input type="hidden" name="ordersPage" value="<%= ordersCurrentPage %>">
                    
                    <div class="input-group input-group-sm">
                        <input type="text" name="catSearch" class="form-control" placeholder="Search categories..." value="<%= catSearch %>">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                        <!-- Clear button appears only if there is an active search -->
                        <% if (catSearch) { %>
                            <a href="/admin/sales-report?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&ordersPage=<%= ordersCurrentPage %>" class="btn btn-secondary text-white" title="Clear Search">
                                <i class="fas fa-times"></i>
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>
            
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Total Orders</th>
                            <th>Revenue Generated</th>
                            <th>Top Selling Item</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (categoryPerformance && categoryPerformance.length > 0) { %>
                            <% categoryPerformance.forEach((cat) => { %>
                            <tr>
                                <td class="fw-bold"><%= cat.categoryName %></td>
                                <td><%= cat.totalOrders %></td>
                                <td class="text-success fw-bold">₹<%= cat.totalRevenue.toFixed(2) %></td>
                                <td class="text-muted"><%= cat.topSellingBook %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" class="text-center py-4 text-muted">No categories match your search.</td></tr>
                        <% } %>
                    </tbody>
                </table>
                
                <% if (catTotalPages >= 1) { %>
                <nav aria-label="Category Page navigation" class="mt-3">
                    <ul class="pagination justify-content-end">
                        <li class="page-item <%= catCurrentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= ordersCurrentPage %>&catPage=<%= catCurrentPage - 1 %>">Previous</a>
                        </li>
                        <% for(let i = 1; i <= catTotalPages; i++) { %>
                            <li class="page-item <%= i === catCurrentPage ? 'active' : '' %>">
                                <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= ordersCurrentPage %>&catPage=<%= i %>"><%= i %></a>
                            </li>
                        <% } %>
                        <li class="page-item <%= catCurrentPage === catTotalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?filter=<%= filter %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>&ordersSearch=<%= ordersSearch %>&catSearch=<%= catSearch %>&ordersPage=<%= ordersCurrentPage %>&catPage=<%= catCurrentPage + 1 %>">Next</a>
                        </li>
                    </ul>
                </nav>
                <% } %>
            </div>
        </div>

    </main>
</div>
<script>
    window.salesChartData = <%- JSON.stringify(chartData || {}) %>;
</script>
<script src="/js/salesReport.js"></script>

<%- include('../partials/footer') %>