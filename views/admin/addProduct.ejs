<%- include('../partials/header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="page-wrapper">

    <div class="product-layout">

        <div class="product-card">

            <h2>Product Information</h2>

            <form
                action="/admin/product/add"
                method="POST"
                enctype="multipart/form-data"
            >

                <div class="form-group">
                    <label>
                        Product Name <span>*</span>
                    </label>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        placeholder="Enter product name"
                        value="<%= typeof product !== 'undefined' ? product.title : '' %>"
                    >
                    <span class="error-message" id="titleError"></span>
                </div>

                <div class="form-group">
                    <label>
                        Category <span>*</span>
                    </label>
                    <select
                        name="category"
                        id="category"
                    >
                        <option value="">
                            Select category
                        </option>
                        <% categories.forEach(category => { %>
                            <option 
                                value="<%= category._id %>"
                                <%= typeof product !== 'undefined' && product.category === category._id.toString() ? 'selected' : '' %>
                            >
                                <%= category.name %>
                            </option>
                        <% }) %>
                    </select>
                    <span class="error-message" id="categoryError"></span>
                </div>

                <div class="form-group">
                    <label>
                        Author <span>*</span>
                    </label>
                    <input
                        type="text"
                        name="author"
                        id="author"
                        placeholder="Enter author name"
                        value="<%= typeof product !== 'undefined' ? product.author : '' %>"
                    >
                    <span class="error-message" id="authorError"></span>
                </div>

                <!-- NEW FIELDS START -->
                <div class="row">
                    <div class="form-group">
                        <label>
                            Publisher <span>*</span>
                        </label>
                        <input
                            type="text"
                            name="publisher"
                            id="publisher"
                            placeholder="Enter publisher"
                            value="<%= typeof product !== 'undefined' ? product.publisher : '' %>"
                        >
                        <span class="error-message" id="publisherError"></span>
                    </div>

                    <div class="form-group">
                        <label>
                            Language <span>*</span>
                        </label>
                        <input
                            type="text"
                            name="language"
                            id="language"
                            placeholder="Enter language"
                            value="<%= typeof product !== 'undefined' ? product.language : '' %>"
                        >
                        <span class="error-message" id="languageError"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <label>
                            ISBN <span>*</span>
                        </label>
                        <input
                            type="text"
                            name="isbn"
                            id="isbn"
                            placeholder="Enter ISBN"
                            value="<%= typeof product !== 'undefined' ? product.isbn : '' %>"
                        >
                        <span class="error-message" id="isbnError"></span>
                    </div>

                    <div class="form-group">
                        <label>
                            Publication Date <span>*</span>
                        </label>
                        <input
                            type="date"
                            name="publicationDate"
                            id="publicationDate"
                            value="<%= typeof product !== 'undefined' && product.publicationDate ? new Date(product.publicationDate).toISOString().split('T')[0] : '' %>"
                        >
                        <span class="error-message" id="publicationDateError"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>
                        Number of Pages <span>*</span>
                    </label>
                    <input
                        type="number"
                        name="pages"
                        id="pages"
                        placeholder="Enter number of pages"
                        value="<%= typeof product !== 'undefined' ? product.pages : '' %>"
                    >
                    <span class="error-message" id="pagesError"></span>
                </div>
                <!-- NEW FIELDS END -->

                <div class="form-group">
                    <label>
                        Description <span>*</span>
                    </label>
                    <textarea
                        name="description"
                        id="description"
                        rows="5"
                        placeholder="Enter product description"
                    ><%= typeof product !== 'undefined' ? product.description : '' %></textarea>
                    <span class="error-message" id="descriptionError"></span>
                </div>

                <div class="row">

                    <div class="form-group">
                        <label>
                            Price <span>*</span>
                        </label>
                        <div class="input-box">
                            <span>₹</span>
                            <input
                                type="number"
                                name="price"
                                id="price"
                                placeholder="Enter price"
                                value="<%= typeof product !== 'undefined' ? product.price : '' %>"
                            >
                        </div>
                        <span class="error-message" id="priceError"></span>
                    </div>

                    <div class="form-group">
                        <label>
                            Stock <span>*</span>
                        </label>
                        <input
                            type="number"
                            name="quantity"
                            id="quantity"
                            placeholder="Enter stock"
                            value="<%= typeof product !== 'undefined' ? product.quantity : '' %>"
                        >
                        <span class="error-message" id="quantityError"></span>
                    </div>

                </div>

                <div class="form-group">
                    <label>Status</label>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input
                                type="radio"
                                name="status"
                                value="active"
                                <%= (typeof product === 'undefined' || product.status === 'active') ? 'checked' : '' %>
                            >
                            Active
                        </label>
                        <label class="radio-option">
                            <input
                                type="radio"
                                name="status"
                                value="inactive"
                                <%= (typeof product !== 'undefined' && product.status === 'inactive') ? 'checked' : '' %>
                            >
                            Not Active
                        </label>
                    </div>
                </div>

                <div class="upload-card">
                    <h3>Product Images</h3>
                    <div
                        class="upload-box"
                        id="dropArea"
                    >
                        <input
                            type="file"
                            id="imageUpload"
                            name="images"
                            multiple
                            accept="image/*"
                            hidden
                        >
                        <div id="uploadContent">
                            <div class="upload-icon">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                            </div>
                            <h4>Click or Drag Images</h4>
                            <p>Minimum 3 Images</p>
                            <small>Maximum 5 Images</small>
                        </div>
                    </div>
                    
                    <span class="error-message" id="imageError" style="text-align: center; margin-top: 10px;"></span>

                    <div
                        id="previewContainer"
                        class="preview-container"
                    ></div>
                </div>

                <div class="button-group">
                    <button
                        type="submit"
                        class="save-btn"
                    >
                        Save Product
                    </button>
                    <button
                        type="button"
                        class="reset-btn"
                        onclick="window.location.href='/admin/products'"
                    >
                        Cancel
                    </button>
                </div>

            </form>

        </div>

        <div class="sidebar-card">
            <div class="tips-card">
                <h3>💡 Quick Tips</h3>
                <ul>
                    <li>Enter accurate product information</li>
                    <li>Upload minimum 3 images</li>
                    <li>Use high-quality images</li>
                    <li>Set correct stock quantity</li>
                    <li>Check category before saving</li>
                </ul>
            </div>
        </div>

    </div>

</div>

<%- include('../partials/footer') %>