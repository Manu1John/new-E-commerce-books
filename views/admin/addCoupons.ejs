<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/adminLayout.css">
<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1>
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
            <li><a href="/admin/users"><i class="fa-solid fa-users"></i> Users</a></li>
            <li><a href="/admin/sales-report"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li>
            <li><a href="/admin/offers"><i class="fa-solid fa-tags"></i> Offers</a></li>
            <li><a href="/admin/coupons" class="active"><i class="fa-solid fa-ticket"></i> Coupons</a></li>
            <li><a href="/admin/category"><i class="fa-solid fa-list"></i> Categories</a></li>
            <li class="logout-item">
                <form action="/admin/logout" method="POST">
                    <button class="logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <div class="page-header-wrapper mb-4">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb">
                    <li><a href="/admin/dashboard">Dashboard</a></li>
                    <li><a href="/admin/coupons">Coupons</a></li>
                    <li class="active">Add Coupon</li>
                </ol>
            </nav>
            <h2 class="page-title">Create New Coupon</h2>
        </div>

        <div class="form-layout-grid">
            <!-- Form Section -->
            <div class="card-custom form-card">
                <h3 class="section-title"><i class="fa-solid fa-ticket me-2 text-primary"></i> Coupon Details</h3>
                
                <form id="couponForm" class="d-flex flex-column h-100">
                    <div class="row-grid">
                        <div class="form-group">
                            <label>Coupon Code <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <input type="text" name="code" class="form-control-custom" placeholder="e.g., SUMMER50" style="text-transform: uppercase;" required>
                                <i class="fa-solid fa-barcode input-icon text-muted"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Discount Value <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <input type="number" name="discountValue" class="form-control-custom pe-5" placeholder="Amount or %" min="0" required>
                                <i class="fa-solid fa-coins input-icon text-muted"></i>
                            </div>
                        </div>
                    </div>

                    <div class="row-grid">
                        <div class="form-group">
                            <label>Discount Type <span class="text-danger">*</span></label>
                            <select name="discountType" class="form-select-custom" required>
                                <option value="" disabled selected>Select Type...</option>
                                <option value="percentage">Percentage (%)</option>
                                <option value="flat">Flat Amount (₹)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Min Purchase Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" name="minPurchaseAmount" class="form-control-custom" placeholder="e.g., 500" min="0" value="0" required>
                        </div>
                    </div>

                    <div class="row-grid">
                        <div class="form-group">
                            <label>Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="startDate" id="startDate" class="form-control-custom" required>
                        </div>

                        <div class="form-group">
                            <label>Expiry Date <span class="text-danger">*</span></label>
                            <input type="date" name="expiryDate" id="expiryDate" class="form-control-custom" required>
                        </div>
                    </div>

                    <div class="row-grid">
                        <div class="form-group">
                            <label>Visibility Status</label>
                            <div class="radio-group-modern">
                                <label class="radio-card">
                                    <input type="radio" name="isActive" value="true" checked>
                                    <span class="radio-content">
                                        <i class="fa-solid fa-eye text-success me-1"></i> Active
                                    </span>
                                </label>
                                <label class="radio-card">
                                    <input type="radio" name="isActive" value="false">
                                    <span class="radio-content">
                                        <i class="fa-solid fa-eye-slash text-danger me-1"></i> Inactive
                                    </span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Usage Limit (Days Valid) <span class="text-danger">*</span></label>
                            <input type="number" name="usageLimit" id="usageLimit" class="form-control-custom bg-light text-muted" placeholder="Calculated automatically" min="1" readonly required>
                        </div>
                    </div>

                    <div class="form-group flex-grow-1">
                        <label>Description</label>
                        <textarea name="description" class="form-control-custom" rows="3" placeholder="Enter optional coupon details..."></textarea>
                    </div>

                    <div class="form-actions mt-auto pt-4 border-top">
                        <button type="button" class="btn-outline-pill" onclick="window.location.href='/admin/coupons'">Cancel</button>
                        <button type="submit" class="btn-primary-pill"><i class="fa-solid fa-check me-1"></i> Save Coupon</button>
                    </div>
                </form>
            </div>

            <!-- Tips Sidebar -->
            <div class="sidebar-card-wrapper">
                <div class="card-custom highlight-card-soft">
                    <h3 class="highlight-title"><i class="fa-regular fa-lightbulb me-2"></i> Coupon Tips</h3>
                    <ul class="tips-list">
                        <li><i class="fa-solid fa-check text-success"></i> <strong>Percentage</strong> discounts apply a ratio reduction (e.g., 10% off). Do not exceed 99.</li>
                        <li><i class="fa-solid fa-check text-success"></i> <strong>Flat Amount</strong> discounts apply a direct currency reduction (e.g., ₹100 off).</li>
                        <li><i class="fa-solid fa-check text-success"></i> The <strong>Usage Limit</strong> is automatically calculated based on the span between your start and expiry dates.</li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</div>


<%- include('../partials/footer') %>
