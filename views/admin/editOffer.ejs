<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/adminLayout.css">
<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1>
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
            <li><a href="/admin/users"><i class="fa-solid fa-users"></i> Users</a></li>
            <li><a href="/admin/sales-report"><i class="fa-solid fa-file-invoice"></i> Reports</a></li>
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li>
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li>
            <li><a href="/admin/offers" class="active"><i class="fa-solid fa-tags"></i> Offers</a></li>
            <li><a href="/admin/coupons"><i class="fa-solid fa-ticket"></i> Coupons</a></li>
            <li><a href="/admin/category"><i class="fa-solid fa-list"></i> Categories</a></li>
            <li class="logout-item">
                <form action="/admin/logout" method="POST">
                    <button class="logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <div class="page-header-wrapper mb-4">
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb">
                    <li><a href="/admin/dashboard">Dashboard</a></li>
                    <li><a href="/admin/offers">Offers</a></li>
                    <li class="active">Edit Offer</li>
                </ol>
            </nav>
            <h2 class="page-title">Edit Offer Details</h2>
        </div>

        <div class="form-layout-grid">
            <!-- Form Section -->
            <div class="card-custom form-card">
                <h3 class="section-title"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Update Information</h3>
                
                <form id="offerForm" class="d-flex flex-column h-100">
                    <div class="row-grid">
                        <div class="form-group">
                            <label>Offer Name <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <input type="text" name="name" class="form-control-custom" value="<%= offer.name %>" required>
                                <i class="fa-solid fa-pen input-icon text-muted"></i>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Discount Percentage <span class="text-danger">*</span></label>
                            <div class="input-wrapper">
                                <input type="number" name="discountPercentage" class="form-control-custom pe-5" value="<%= offer.discountPercentage %>" required>
                                <i class="fa-solid fa-percent input-icon text-muted"></i>
                            </div>
                        </div>
                    </div>

                    <div class="row-grid">
                        <div class="form-group">
                            <label>Offer Type <span class="text-danger">*</span></label>
                            <select name="type" id="offerType" class="form-select-custom" required>
                                <option value="product" <%= offer.type === 'product' ? 'selected' : '' %>>Product Specific</option>
                                <option value="category" <%= offer.type === 'category' ? 'selected' : '' %>>Category Specific</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label id="dynamicLabel">Select Item <span class="text-danger">*</span></label>
                            <select name="productRef" id="dynamicSelect" class="form-select-custom" required>
                                <!-- Populated dynamically by JS -->
                            </select>
                        </div>
                    </div>

                    <div class="row-grid">
                        <div class="form-group">
                            <label>Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="startDate" id="startDate" class="form-control-custom" required value="<%= new Date(offer.startDate).toISOString().split('T')[0] %>">
                        </div>

                        <div class="form-group">
                            <label>Expiry Date <span class="text-danger">*</span></label>
                            <input type="date" name="expiryDate" id="expiryDate" class="form-control-custom" required value="<%= new Date(offer.expiryDate).toISOString().split('T')[0] %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Visibility Status</label>
                        <div class="radio-group-modern">
                            <label class="radio-card">
                                <input type="radio" name="isActive" value="true" <%= offer.isActive ? 'checked' : '' %>>
                                <span class="radio-content">
                                    <i class="fa-solid fa-eye text-success me-1"></i> Active
                                </span>
                            </label>
                            <label class="radio-card">
                                <input type="radio" name="isActive" value="false" <%= !offer.isActive ? 'checked' : '' %>>
                                <span class="radio-content">
                                    <i class="fa-solid fa-eye-slash text-danger me-1"></i> Inactive
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="form-actions mt-auto pt-4 border-top">
                        <button type="button" class="btn-outline-pill" onclick="window.location.href='/admin/offers'">Cancel</button>
                        <button type="submit" class="btn-primary-pill"><i class="fa-solid fa-arrows-rotate me-1"></i> Update Offer</button>
                    </div>
                </form>
            </div>

            <!-- Tips Sidebar -->
            <div class="sidebar-card-wrapper">
                <div class="card-custom highlight-card-soft">
                    <h3 class="highlight-title"><i class="fa-regular fa-lightbulb me-2"></i> Editing Tips</h3>
                    <ul class="tips-list">
                        <li><i class="fa-solid fa-check text-success"></i> Changing the offer type will immediately clear the previously selected item.</li>
                        <li><i class="fa-solid fa-check text-success"></i> If you disable an offer, it will immediately stop applying discounts to user carts.</li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</div>

<!-- Data Injection for JS -->
<script>
    window.offerData = {
        products: <%- JSON.stringify(products || []) %>,
        categories: <%- JSON.stringify(categories || []) %>,
        currentOffer: <%- JSON.stringify(offer || {}) %>
    }; 
</script>

<script src="/js/editOffers.js"></script>

<%- include('../partials/footer') %>