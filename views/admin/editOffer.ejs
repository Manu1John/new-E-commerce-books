<%- include('../partials/header') %>
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

<div class="page-container">
    <header class="page-header">
        <h1>Edit Offer</h1>
        <p>Update existing offer details.</p>
    </header>

    <!-- Form ID replaces action to allow Fetch API -->
    <form class="offer-form" id="offerForm">
        <div class="card">
            
            <div class="card-header">
                <div class="header-icon">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div class="header-text">
                    <h2>Offer Details</h2>
                    <p>Modify the information below to edit an offer.</p>
                </div>
            </div>

            <div class="card-body">
                <div class="form-grid">
                    
                    <div class="form-group">
                        <label>Offer Name <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="text" name="name" value="<%= offer.name %>" required>
                            <i class="fa-regular fa-keyboard input-icon"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Discount % <span class="required">*</span></label>
                        <div class="input-wrapper input-wrapper-group">
                            <input type="number" name="discountPercentage" value="<%= offer.discountPercentage %>" required>
                            <span class="input-suffix">%</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Select Product / Category <span class="required">*</span></label>
                        <select name="type" id="offerType" required>
                            <option value="product" <%= offer.type === 'product' ? 'selected' : '' %>>Product</option>
                            <option value="category" <%= offer.type === 'category' ? 'selected' : '' %>>Category</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label id="dynamicLabel">Select Item Name <span class="required">*</span></label>
                        <select name="productRef" id="dynamicSelect" required>
                            <!-- Populated dynamically -->
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Start Date <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="date" name="startDate" id="startDate" required value="<%= new Date(offer.startDate).toISOString().split('T')[0] %>" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>End Date (Expiry) <span class="required">*</span></label>
                        <div class="input-wrapper">
                            <input type="date" name="expiryDate" id="expiryDate" required value="<%= new Date(offer.expiryDate).toISOString().split('T')[0] %>" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit;">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Status <span class="required">*</span></label>
                        <select name="isActive" required>
                            <option value="true" <%= offer.isActive ? 'selected' : '' %>>Active</option>
                            <option value="false" <%= !offer.isActive ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>

                </div>

            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-regular fa-floppy-disk"></i> Update Offer
                </button>
            </div>

        </div>
    </form>
</div>

<script>
    window.offerData = {
        products: <%- JSON.stringify(products || []) %>,
        categories: <%- JSON.stringify(categories || []) %>,
        currentOffer: <%- JSON.stringify(offer || {}) %>
    }; 
</script>

<script src="/js/editOffers.js"></script> 
</body>
<%- include('../partials/footer') %>