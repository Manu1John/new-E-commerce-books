<%- include('../partials/header') %> <!--[cite: 21] -->
<!-- FontAwesome & SweetAlert2 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!--[cite: 21] -->

<div class="dashboard-container">
    <!-- Mobile Header -->
    <div class="mobile-header">
        <h1 class="logo">Admin Panel</h1>
        <button id="sidebarToggle" class="mobile-toggle"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h1 class="logo">Admin Panel</h1> <!--[cite: 21] -->
        </div>
        <ul class="menu">
            <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li> <!--[cite: 21] -->
            <li><a href="/admin/users"><i class="fa-solid fa-users"></i> Users</a></li> <!--[cite: 21] -->
            <li><a href="/admin/sales-report"><i class="fa-solid fa-file-invoice"></i> Reports</a></li> <!--[cite: 21] -->
            <li><a href="/admin/products"><i class="fa-solid fa-box"></i> Products</a></li> <!--[cite: 21] -->
            <li><a href="/admin/orders"><i class="fa-solid fa-cart-shopping"></i> Orders</a></li> <!--[cite: 21] -->
            <li><a href="/admin/offers" class="active"><i class="fa-solid fa-tags"></i> Offers</a></li> <!--[cite: 21] -->
            <li><a href="/admin/coupons"><i class="fa-solid fa-ticket"></i> Coupons</a></li> <!--[cite: 21] -->
            <li><a href="/admin/category"><i class="fa-solid fa-list"></i> Categories</a></li> <!--[cite: 21] -->
            <li class="logout-item">
                <form action="/admin/logout" method="POST"> <!--[cite: 21] -->
                    <button class="logout-btn" type="submit">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout <!--[cite: 21] -->
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        
        <!-- Breadcrumb & Header Section -->
        <div class="page-header-wrapper">
            <div>
                <nav aria-label="breadcrumb" class="breadcrumb-nav">
                    <ol class="breadcrumb">
                        <li><a href="/admin/dashboard">Dashboard</a></li>
                        <li class="active">Offer Management</li>
                    </ol>
                </nav>
                <h2 class="page-title">Offers & Promotions</h2> <!--[cite: 21] -->
                <p class="text-muted mb-0">Manage discounts for products, categories, and referrals.</p>
            </div>
            
            <div class="header-actions">
                <a href="/admin/offers/add" class="btn-primary-pill"><i class="fa-solid fa-plus me-1"></i> Add New Offer</a> <!--[cite: 21] -->
            </div>
        </div>

        <!-- Search Bar -->
        <div class="search-container mt-4">
            <form action="/admin/offers" method="GET" id="searchForm" class="search-form"> <!--[cite: 21] -->
                <div class="search-input-group">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text" name="search" id="searchInput" placeholder="Search Offers..." value="<%= typeof search !== 'undefined' ? search : '' %>"> <!--[cite: 21] -->
                    <% if (typeof search !== 'undefined' && search.length > 0) { %> <!--[cite: 21] -->
                        <button type="button" class="clear-search-btn" title="Clear Search" onclick="window.location.href='/admin/offers'"> <!--[cite: 21] -->
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Offers Table -->
        <div class="table-custom-wrapper mt-4">
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>No</th> <!--[cite: 21] -->
                            <th>Offer Details</th> <!--[cite: 21] -->
                            <th>Discount</th> <!--[cite: 21] -->
                            <th>Assigned To</th> <!--[cite: 21] -->
                            <th>Expiry Date</th> <!--[cite: 21] -->
                            <th>Status</th> <!--[cite: 21] -->
                            <th class="text-center">Actions</th> <!--[cite: 21] -->
                        </tr>
                    </thead>
                    <tbody>
                        <% if (offers && offers.length > 0) { %> <!--[cite: 21] -->
                            <% offers.forEach((offer, index) => { %> <!--[cite: 21] -->
                            <tr>
                                <td class="text-muted fw-bold">#<%= index + 1 %></td> <!--[cite: 21] -->
                                <td>
                                    <div class="offer-name-cell">
                                        <div class="offer-icon"><i class="fa-solid fa-tag"></i></div>
                                        <div>
                                            <span class="fw-bold d-block"><%= offer.name %></span> <!--[cite: 21] -->
                                            <span class="text-muted" style="font-size: 0.8rem; text-transform: capitalize;"><%= offer.type %> Offer</span> <!--[cite: 21] -->
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-success" style="font-size: 0.85rem;"><%= offer.discountPercentage %>% OFF</span> <!--[cite: 21] -->
                                </td>
                                <td class="text-muted fw-bold">
                                    <% if (offer.type === 'product' && offer.productRef) { %> <!--[cite: 21] -->
                                        <i class="fa-solid fa-box me-1"></i> <%= offer.productRef.title %> <!--[cite: 21] -->
                                    <% } else if (offer.type === 'category' && offer.categoryRef) { %> <!--[cite: 21] -->
                                        <i class="fa-solid fa-list me-1"></i> <%= offer.categoryRef.name %> <!--[cite: 21] -->
                                    <% } else { %>
                                        <span class="badge badge-neutral">General / Referral</span> <!--[cite: 21] -->
                                    <% } %>
                                </td>
                                <td>
                                    <i class="fa-regular fa-calendar me-1 text-muted"></i> 
                                    <%= new Date(offer.expiryDate).toLocaleDateString() %> <!--[cite: 21] -->
                                </td>
                                <td>
                                    <span class="badge <%= offer.isActive ? 'badge-success' : 'badge-danger' %>"> <!--[cite: 21] -->
                                        <%= offer.isActive ? 'Active' : 'Inactive' %> <!--[cite: 21] -->
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="action-buttons">
                                        <a href="/admin/offers/edit/<%= offer._id %>" class="action-btn btn-edit" title="Edit Offer"> <!--[cite: 21] -->
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <button type="button" class="action-btn btn-delete delete-offer-btn" data-id="<%= offer._id %>" title="Delete Offer"> <!--[cite: 21] -->
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted"> <!--[cite: 21] -->
                                    <i class="fa-solid fa-tags fs-1 mb-3 d-block"></i>
                                    No Offers found matching your criteria. <!--[cite: 21] -->
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %> <!--[cite: 21] -->
        <div class="pagination-wrapper mt-4">
            <div class="pagination-custom">
                <% if (currentPage > 1) { %> <!--[cite: 21] -->
                    <a href="?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>" class="page-link prev-next"> <!--[cite: 21] -->
                        <i class="fa-solid fa-chevron-left"></i> Prev
                    </a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %> <!--[cite: 21] -->
                    <a href="?page=<%= i %><%= search ? '&search=' + search : '' %>" class="page-link <%= currentPage === i ? 'active' : '' %>"> <!--[cite: 21] -->
                        <%= i %> <!--[cite: 21] -->
                    </a>
                <% } %>
                
                <% if (currentPage < totalPages) { %> <!--[cite: 21] -->
                    <a href="?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>" class="page-link prev-next"> <!--[cite: 21] -->
                        Next <i class="fa-solid fa-chevron-right"></i>
                    </a>
                <% } %>
            </div>
        </div>
        <% } %>

    </main>
</div>

<%- include('../partials/footer') %> <!--[cite: 21] -->