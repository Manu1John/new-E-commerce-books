<%- include('../partials/header', { authFlowGuard: true }) %>

<div class="container">

    <h1>Verify OTP</h1>

    <p>
        We sent a verification code to your email.
        Enter the OTP below to continue.
    </p>

    <% if(error){ %>
        <div class="alert alert-error">
            <%= error %>
        </div>
    <% } %>

    <% if(success){ %>
        <div class="alert alert-success">
            <%= success %>
        </div>
    <% } %>

    <form action="/verify-forgot-otp" method="POST">

        <input
            type="text"
            name="otp"
            class="otp-input"
            placeholder="Enter OTP"
            maxlength="6"
            required
        >

        <button type="submit">
            Verify OTP
        </button>

    </form>

    <p id="timer">
        Resend OTP in
        <span id="countdown"></span>
        seconds
    </p>

    <form action="/resend-forgot-otp" method="POST">

        <button
            type="submit"
            class="resend-btn"
            id="resendBtn"
        >
            Resend OTP
        </button>

    </form>
 
</div>

<!-- Frontend Timer Logic Embedded -->
<script>
    const countdownElement = document.getElementById("countdown");
    const resendBtn = document.getElementById("resendBtn");

    // Disable button initially
    resendBtn.disabled = true;

    // 1. Use a unique key for the forgot password flow
    let expiryTime = sessionStorage.getItem("forgotOtpExpiryTime");

    if (!expiryTime) {
        // Set for 60 seconds from now
        expiryTime = new Date().getTime() + 60000;
        sessionStorage.setItem("forgotOtpExpiryTime", expiryTime);
    }

    const countdown = setInterval(() => {
        
        // 2. Calculate remaining time
        const now = new Date().getTime();
        const timeLeft = Math.floor((expiryTime - now) / 1000);

        // When timer reaches zero
        if (timeLeft <= 0) {
            clearInterval(countdown);
            
            // Clean up the storage so a new timer can start later
            sessionStorage.removeItem("forgotOtpExpiryTime"); 

            resendBtn.disabled = false;
            resendBtn.innerHTML = "Resend OTP Now";
            countdownElement.innerText = "00:00";
        } else {
            // 3. Update the UI
            let minutes = Math.floor(timeLeft / 60);
            let seconds = timeLeft % 60;

            // Add leading zero
            if (seconds < 10) {
                seconds = "0" + seconds;
            }
            if (minutes < 10) {
                minutes = "0" + minutes;
            }

            // Update ONLY the span
            countdownElement.innerText = `${minutes}:${seconds}`;
        }

    }, 1000);

    // 4. Ensure clicking "Resend OTP" clears the old timer
    resendBtn.addEventListener("click", () => {
        sessionStorage.removeItem("forgotOtpExpiryTime");
    });
</script>

<%- include('../partials/footer') %>