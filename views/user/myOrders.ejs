<%- include('../partials/header') %>

    <!-- Header Section -->
    <header class="page-header">
        <span class="subtitle">TRACK YOUR PURCHASE</span>
        <h1>ORDER DETAILS</h1>
    </header>

    <!-- Main Content -->
    <main class="container">
        <div class="layout-grid">
            
            <!-- Left Column: Ordered Items -->
            <div class="left-col">
                <h2 class="section-title">Ordered Items</h2>

                <% orders.forEach((order, index) => { %>
                <div class="order-card <%= index >= 3 ? 'hidden-order' : '' %>">
                    <% order.items.forEach((item) => { %>
                    <div class="product-info">
                        
                        <div class="product-image">
                            <img src="<%= item.product?.images?.length ? '/uploads/' + item.product.images[0] : 'https://via.placeholder.com/80x100?text=Book+Cover' %>" alt="Book Cover">
                        </div>
                        <div class="product-details">
                            <h3>Title: <%=item.product.title%></h3>
                            <p>Author: <%=item.product.author%></p>
                            <p>Quantity: <%=item.quantity%></p>
                            <p class="price">Price: ₹<%=item.finalPrice || item.price%></p>
                            <p>Status: <%= item.status || order.status %></p>
                        </div>
                        
                    </div>
                    <% }) %>
                    
                    <div class="order-meta">
                        <strong><%=order.orderId%></strong>
                        <span class="badge badge-shipped"><%=order.displayStatus || order.status%></span>
                    </div>    
                    
                    <div class="order-grid">
                        <div class="grid-item">
                            <label>Order Date</label>
                            <strong><%=new Date(order.createdAt).toLocaleDateString()%></strong>
                        </div>
                        <div class="grid-item">
                            <label>Total Amount</label>
                            <strong>₹<%=order.money ? order.money.finalTotal : order.finalAmount%></strong>
                        </div>
                        <div class="grid-item">
                            <label>Payment Method</label>
                            <strong><%=order.paymentMethod%></strong>
                        </div>
                    </div>

                    <div class="action-buttons dual">
                        <a href="/orders/<%= order._id %>" class="btn btn-dark">VIEW DETAILS</a>
                        <a href="/orders/<%= order._id %>/invoice" class="btn btn-olive">INVOICE</a>
                        <% if ((order.displayStatus || order.status) === "Delivered") { %>
                            <button type="button" class="btn btn-red open-return-modal" data-order-id="<%=order._id%>">RETURN ORDER</button>
                        <% } else if (!["Cancelled", "Returned", "Refunded"].includes(order.displayStatus || order.status)) { %>
                            <button type="button" class="btn btn-dark open-cancel-modal" data-order-id="<%=order._id%>">CANCEL ORDER</button>
                        <% } %>
                        
                        <!-- Dynamic Track Order Button -->
                        <button type="button" class="btn btn-olive track-order-btn" 
                            data-status="<%=order.displayStatus || order.status%>"
                            data-items='<%- JSON.stringify(order.items.map(item => ({ title: item.product?.title || "Product", status: item.status || order.status }))) %>'
                            data-date="<%=order.createdAt%>"
                            data-total="<%=order.totalAmount%>"
                            data-shipping="<%=order.shippingFee%>"
                            data-tax="<%=order.tax%>"
                            data-discount="<%=order.discount%>"
                            data-final="<%=order.finalAmount%>"
                        >Track Order</button>
                    </div>
                </div>
                <% }) %>                

                <!-- View All Button -->
                <% if (orders && orders.length > 3) { %>
                    <button type="button" class="btn btn-dark view-all-btn" id="viewAllOrdersBtn">View All <%= orders.length %> Orders</button>
                <% } %>

            </div>

            <!-- Right Column: Dynamic Summary & Tracking -->
            <div class="right-col">
                <!-- Payment Summary -->
                <div class="summary-section">
                    <h2 class="section-title">Payment Summary</h2>
                    <div class="summary-row">
                        <span>Items Total</span>
                        <span id="sum-subtotal">₹0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span id="sum-shipping">₹0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Taxes</span>
                        <span id="sum-tax">₹0.00</span>
                    </div>
                    <div class="summary-row">
                        <span>Discount</span>
                        <span id="sum-discount">-₹0.00</span>
                    </div>
                    <hr>
                    <div class="summary-row total">
                        <span>Total</span>
                        <span id="sum-total">₹0.00</span>
                    </div>
                </div>

                <!-- Order Tracking -->
                <div class="tracking-section">
                    <h2 class="section-title">Order Tracking</h2>
                    <div class="timeline" id="tracking-timeline">
                        <!-- Content will be injected via JS -->
                        <p style="color: #777;">Click "Track Order" on an item to view its status.</p>
                    </div>
                </div>


            </div>
        </div>
    </main>

    <!-- Cancel Order Modal Overlay -->
    <div id="cancelOrderModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Cancel Order</h2>
                <button class="close-modal-btn">&times;</button>
            </div>
            
            <form id="cancelOrderForm">
                <input type="hidden" id="cancelOrderId" name="orderId" value="">
                
                <div class="form-group">
                    <label>Please select a reason for cancellation:</label>
                    <div class="radio-group">
                        <label><input type="radio" name="cancelReason" value="Changed my mind" required> Changed my mind</label>
                        <label><input type="radio" name="cancelReason" value="Expected delivery time is too long"> Expected delivery time is too long</label>
                        <label><input type="radio" name="cancelReason" value="Found a better price elsewhere"> Found a better price elsewhere</label>
                        <label><input type="radio" name="cancelReason" value="Ordered by mistake"> Ordered by mistake</label>
                        <label><input type="radio" name="cancelReason" value="Other"> Other</label>
                    </div>
                </div>

                <div class="form-group hidden" id="otherReasonGroup">
                    <label for="otherReasonText">Please specify:</label>
                    <textarea id="otherReasonText" name="otherReasonText" rows="3" placeholder="Tell us more about why you are cancelling..."></textarea>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-dark cancel-modal-btn">Keep Order</button>
                    <button type="submit" class="btn btn-red confirm-cancel-btn">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Return Order Modal Overlay -->
    <div id="returnOrderModal" class="modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Return Order</h2>
                <button class="close-modal-btn" id="closeReturnModalBtn">&times;</button>
            </div>
            
            <form id="returnOrderForm">
                <input type="hidden" id="returnOrderId" name="orderId" value="">
                
                <div class="form-group">
                    <label>Please select a reason for return:</label>
                    <div class="radio-group">
                        <label><input type="radio" name="returnReason" value="Item damaged or defective" required> Item damaged or defective</label>
                        <label><input type="radio" name="returnReason" value="Received wrong item"> Received wrong item</label>
                        <label><input type="radio" name="returnReason" value="Item does not match description"> Item does not match description</label>
                        <label><input type="radio" name="returnReason" value="Other"> Other</label>
                    </div>
                </div>

                <div class="form-group hidden" id="otherReturnReasonGroup">
                    <label for="otherReturnReasonText">Please specify:</label>
                    <textarea id="otherReturnReasonText" name="otherReturnReasonText" rows="3" placeholder="Tell us more about why you are returning this item..."></textarea>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-dark" id="cancelReturnModalBtn">Keep Order</button>
                    <button type="submit" class="btn btn-red confirm-return-btn">Confirm Return</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Hamburger Menu Logic
            const hamburgerBtn = document.getElementById('hamburger-btn');
            const navLinks = document.getElementById('nav-links');
            
            if (hamburgerBtn && navLinks) {
                hamburgerBtn.addEventListener('click', () => {
                    navLinks.classList.toggle('active');
                    // Toggle icon between bars and close
                    const icon = hamburgerBtn.querySelector('i');
                    if (navLinks.classList.contains('active')) {
                        icon.classList.remove('fa-bars');
                        icon.classList.add('fa-times');
                    } else {
                        icon.classList.remove('fa-times');
                        icon.classList.add('fa-bars');
                    }
                });
            }

            // View All Orders Logic
            const viewAllBtn = document.getElementById('viewAllOrdersBtn');
            if (viewAllBtn) {
                viewAllBtn.addEventListener('click', () => {
                    const hiddenOrders = document.querySelectorAll('.hidden-order');
                    hiddenOrders.forEach(order => {
                        order.style.display = 'block'; 
                        // Small timeout to allow CSS transition
                        setTimeout(() => order.style.opacity = '1', 10);
                    });
                    viewAllBtn.style.display = 'none'; // Hide button after clicking
                });
            }
        });
    </script>

<%- include('../partials/footer') %>
