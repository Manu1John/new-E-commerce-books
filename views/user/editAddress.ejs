<%- include('../partials/header') %>

<!-- PAGE -->
<section class="add-address-page">

    <div class="page-header">
        <p class="breadcrumb">
            <a href="/" class="text-decoration-none text-muted">HOME</a> / 
            <a href="/profile/user" class="text-decoration-none text-muted">MY ACCOUNT</a> / 
            <a href="/address" class="text-decoration-none text-muted">ADDRESSES</a> /
            <span>EDIT ADDRESS</span>
        </p>
        <h1>Edit Saved Address</h1>
    </div>

    <div class="form-container">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>
        
        <!-- FIX: Put method override and returnTo flag in URL -->
        <form
            action="/address/<%= address._id %>?_method=PUT<%= typeof returnTo !== 'undefined' && returnTo ? '&returnTo=' + returnTo : '' %>"
            method="POST"
            class="address-form"
            id="addressForm"
        >
        
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="fullName" placeholder="Enter full name" id="fullName" value="<%= address.fullName %>" />
                <small class="error" id="nameError"></small>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input type="number" name="phone" maxlength="10" placeholder="Enter phone number" id="phone" value="<%= address.phone %>" />
                <small class="error" id="phoneError"></small>
            </div>

            <div class="form-group">
                <label>House / Flat / Building</label>
                <input type="text" name="house" placeholder="House no, apartment" id="house" value="<%= address.addressLine.split(',')[0].trim() %>" />
                <small class="error" id="houseError"></small>
            </div>

            <div class="form-group">
                <label>Area / Street</label>
                <input type="text" name="area" placeholder="Street, locality" id="area" value="<%= address.addressLine.split(',')[1] ? address.addressLine.split(',')[1].trim() : '' %>" />
                <small class="error" id="areaError"></small>
            </div>

            <div class="form-group">
                <label>Landmark</label>
                <input type="text" name="landmark" placeholder="Nearby landmark" value="<%= address.landmark %>" />
            </div>

            <div class="two-col">
                <div class="form-group">
                    <label>City</label>
                    <input type="text" name="city" placeholder="City" id="city" value="<%= address.city %>" />
                    <small class="error" id="cityError"></small>
                </div>
                <div class="form-group">
                    <label>State</label>
                    <input type="text" name="state" placeholder="State" id="state" value="<%= address.state %>" />
                    <small class="error" id="stateError"></small>
                </div>
            </div>

            <div class="two-col">
                <div class="form-group">
                    <label>Pincode</label>
                    <input type="text" name="pincode" placeholder="Pincode" maxlength="6" id="pincode" value="<%= address.pincode %>" />
                    <small class="error" id="pincodeError"></small>
                </div>
                
                <div class="form-group">
                    <label>Address Type</label>
                    <select name="addressType" id="addressType">
                        <option value="">Select</option>
                        <option value="Home" <%= address.addressType === 'Home' ? 'selected' : '' %>>Home</option>
                        <option value="Office" <%= address.addressType === 'Office' ? 'selected' : '' %>>Office</option>
                    </select>
                    <small class="error" id="typeError"></small>
                </div>
            </div>

            <div class="btn-group">
                <!-- FIX: Route cancel button back to checkout dynamically -->
                <a href="<%= typeof returnTo !== 'undefined' && returnTo === 'checkout' ? '/checkout' : '/address' %>" class="cancel-btn">
                    Cancel
                </a>
                <button type="submit" class="save-btn">
                    Update Address
                </button>
            </div>

        </form>
    </div>

</section>

<%- include('../partials/footer') %>
