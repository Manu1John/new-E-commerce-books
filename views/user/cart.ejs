<head>
    <title><%= title %> | BookStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" type="text/css" href="/icomoon/icomoon.css">
    <link rel="stylesheet" type="text/css" href="/css/index.css">
    <script defer src="/js/cart.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/cart.css">
    <script defer src="/js/jquery-1.11.0.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
        crossorigin="anonymous"></script>
    <script defer src="/js/plugins.js"></script>
    <script defer src="/js/script.js"></script>
</head>
<body>

    <!-- Unified Responsive Navbar -->
    <nav class="navbar navbar-expand-lg bg-white sticky-top shadow-sm py-3" id="header-wrap">
        <div class="container-fluid">
            
            <!-- Logo -->
            <a class="navbar-brand" href="/home">
                <img src="/images/main-logo.png" alt="logo" style="max-height: 40px;">
            </a>

            <!-- Hamburger Toggle Button -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Collapsible Navbar Content -->
            <div class="collapse navbar-collapse" id="navbarContent">
                
<ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
    <li class="nav-item"><a class="nav-link px-3" href="/">Home</a></li>
    <li class="nav-item"><a class="nav-link px-3" href="/#featured-books">Featured</a></li>
    <li class="nav-item"><a class="nav-link px-3" href="/#popular-books">Popular</a></li>
    <li class="nav-item"><a class="nav-link px-3" href="/#special-offer">Offer</a></li>
    <li class="nav-item"><a class="nav-link px-3" href="/#latest-blog">Articles</a></li>
</ul>

                <!-- User Actions (Right Aligned) -->
                <div class="d-flex align-items-center gap-4 mt-3 mt-lg-0">
                    <a href="/profile/user" class="text-decoration-none text-dark d-flex align-items-center gap-1 hover-opacity">
                        <i class="icon icon-user"></i><span>Account</span>
                    </a>
                    <a href="/wishlist" class="text-decoration-none text-dark d-flex align-items-center gap-1 hover-opacity">
                        <i class="icon icon-heart-o"></i><span>Wishlist</span>
                    </a>
                    <a href="/cart" class="text-decoration-none text-dark d-flex align-items-center gap-1 hover-opacity">
                        <i class="icon icon-clipboard"></i><span>Cart:(<%= cartCount %>)</span>
                    </a>
                    <form action="/logout" method="POST" class="m-0 p-0">
                        <button type="submit" class="btn btn-outline-dark btn-sm d-flex align-items-center gap-1">
                            <i class="icon icon-login"></i><span>Logout</span>
                        </button>
                    </form>  
                </div>

            </div>
        </div>
    </nav>

    <main class="container my-5">
        <h2 class="mb-4" style="font-family: var(--heading-font);">Shopping Cart</h2>

        <% if (success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (hasUnavailableItems || hasStockIssues) { %>
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                <span style="font-size: 1.3em;">⚠️</span>
                <div>
                    Some items in your cart require attention. Please review availability or reduce quantities before checking out.
                </div>
            </div>
        <% } %>

        <% if (items.length === 0) { %>
            <div class="text-center py-5 border rounded bg-light">
                <p class="text-muted mb-4" style="font-size: 1.2em;">Your shopping cart is currently empty.</p>
                <a href="/home" class="btn btn-dark px-4 py-2" style="font-weight: 600;">Browse Books</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle cart-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center" style="width: 150px;">Quantity</th>
                                    <th class="text-center">Total</th>
                                    <th class="text-center">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% items.forEach((item, index) => { %>
                                    <tr id="row-<%= item.product ? item.product._id : 'deleted-' + index %>" class="<%= item.isUnavailable ? 'unavailable-row' : '' %>">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                                                    <img src="/uploads/<%= item.product.images[0] %>" class="cart-product-img" alt="Product Image">
                                                <% } else { %>
                                                    <img src="/images/product-item1.jpg" class="cart-product-img" alt="Default Product Image">
                                                <% } %>
                                                <div>
                                                    <% if (item.product) { %>
                                                        <h5 class="mb-1" style="font-size: 1em;"><%= item.product.title %></h5>
                                                        <span class="text-muted d-block" style="font-size: 0.85em;">By <%= item.product.author %></span>
                                                        <% if (item.isUnavailable) { %>
                                                            <span class="warning-text d-block">⚠️ Product is currently unavailable</span>
                                                        <% } else if (item.stockError) { %>
                                                            <span class="warning-text d-block">⚠️ <%= item.stockError %></span>
                                                        <% } %>
                                                    <% } else { %>
                                                        <span class="warning-text">⚠️ Unavailable / Deleted Product</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            ₹<%= item.product ? item.product.price : 0 %>
                                        </td>
                                        <td class="text-center">
                                            <% if (item.product && !item.isUnavailable) { %>
                                                <div class="d-flex align-items-center justify-content-center">
                                                    <button type="button" class="qty-btn" onclick="updateQty('<%= item.product._id %>', 'decrement')">-</button>
                                                    <input type="text" class="qty-display" id="qty-<%= item.product._id %>" value="<%= item.quantity %>" readonly>
                                                    <button type="button" class="qty-btn" onclick="updateQty('<%= item.product._id %>', 'increment')">+</button>
                                                </div>
                                            <% } else { %>
                                                <span class="text-muted"><%= item.quantity %></span>
                                            <% } %>
                                        </td>
                                        <td class="text-center font-monospace" id="total-<%= item.product ? item.product._id : 'deleted-' + index %>">
                                            ₹<%= item.itemTotal %>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="removeItem('<%= item.product ? item.product._id : '' %>')">
                                                🗑️
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="checkout-card p-4">
                        <h4 class="mb-4" style="font-family: var(--heading-font);">Order Summary</h4>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal:</span>
                            <strong id="summary-subtotal">₹<%= cartSubtotal %></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Shipping:</span>
                            <span class="text-success">FREE</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span>Grand Total:</span>
                            <strong class="fs-4" id="summary-total">₹<%= cartSubtotal %></strong>
                        </div>

                        <% if (hasUnavailableItems || hasStockIssues) { %>
                            <button class="btn btn-dark w-100 py-3 disabled" style="font-weight:600; text-transform: uppercase;" disabled>
                                Checkout Blocked
                            </button>
                            <p class="text-center text-danger mt-2" style="font-size:0.8em; font-weight:600;">Fix cart alerts to unlock checkout</p>
                        <% } else { %>
                            <a href="/checkout" class="btn btn-dark w-100 py-3" style="font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
                                Proceed to Checkout
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

<!-- Footer -->
    <footer id="footer" class="bg-dark text-white py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="footer-item">
                        <div class="main-logo mb-3">
                            <a href="/home"><img src="/images/main-logo.png" alt="logo" style="filter: brightness(0) invert(1);"></a>
                        </div>
                        <p>Explore thousands of books directly from our modern bookstore repository.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-item">
                        <h4>Help & Info</h4>
                        <ul class="list-unstyled">
                            <li><a href="#" class="text-white text-decoration-none">Help center</a></li>
                            <li><a href="#" class="text-white text-decoration-none">Contact us</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-item">
                        <h4>Legal</h4>
                        <p>© 2026 All rights reserved. Premium Booksaw Book Store.</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</body>
