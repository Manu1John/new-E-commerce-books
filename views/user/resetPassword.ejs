<%- include('../partials/header', { authFlowGuard: true }) %> <!--[cite: 3] -->
<div class="auth-container"> <!--[cite: 3] -->
    <div class="auth-card"> <!--[cite: 3] -->
        

        <div class="auth-header">
            <h3>Set New Password</h3> <!--[cite: 3] -->
            <p>Please enter your new password below to secure your account.</p>
        </div>
        
        <% if (error) { %> <!--[cite: 3] -->
            <div class="alert alert-error">
                <span class="icon">⚠️</span> <%= error %> <!--[cite: 3] -->
            </div>
        <% } %>

        <form action="/reset-password?_method=PATCH" method="POST" class="auth-form"> <!--[cite: 3] -->
            <div class="input-group">
                <label for="password">New Password</label>
                <input type="password" id="password" name="password" placeholder="Enter new password" required> <!--[cite: 3] -->
            </div>
            
            <div class="input-group">
                <label for="confirmPassword">Confirm New Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required> <!--[cite: 3] -->
            </div>
            
            <button type="submit" class="btn-primary">Update Password</button> <!--[cite: 3] -->
        </form>
    </div>
</div>
<%- include('../partials/footer') %> <!--[cite: 3] -->