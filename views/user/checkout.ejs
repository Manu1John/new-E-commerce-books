<title><%= title %> | BookStore</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" type="text/css" href="/icomoon/icomoon.css">
    <link rel="stylesheet" type="text/css" href="/css/index.css">
    <link rel="stylesheet" type="text/css" href="/css/checkout.css">
    <link rel="stylesheet" href="/css/navbar.css?v=3">
    <script defer src="/js/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- ADD THIS LINE FOR RAZORPAY -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    
    <script defer src="/js/jquery-1.11.0.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
        crossorigin="anonymous"></script>
    <script defer src="/js/plugins.js"></script>
    <script defer src="/js/script.js"></script>
</head>
<body>

<%- include('../partials/navbar') %>

    <main class="container my-5">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-5 display-6 fs-2">Checkout Details</h2>
            </div>
        </div>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-7">
                <div class="checkout-step-title">
                    <span class="step-number">01</span>
                    <h4>Select Delivery Address</h4>
                </div>
                
                <% if (addresses.length === 0) { %>
                    <div id="emptyAddressState" class="text-center py-5 px-4 rounded-4 border" style="background-color: #fff; border-style: dashed !important;">
                        <p class="text-muted mb-4">You don't have any saved delivery addresses yet.</p>
                        <button type="button" class="btn btn-brand-dark btn-sm" data-bs-toggle="modal" data-bs-target="#checkoutAddressModal">Add New Address</button>
                    </div>
                <% } else { %>
                    <div class="address-container" id="checkoutAddressList">
                        <% addresses.forEach((addr, idx) => { %>
                            <div class="address-card <%= idx === 0 ? 'selected' : '' %>" onclick="selectAddress(this, '<%= addr._id %>')">
                                <input type="radio" name="selectedAddr" value="<%= addr._id %>" <%= idx === 0 ? 'checked' : '' %>>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="fs-6"><%= addr.fullName %></strong>
                                        <span class="badge-type"><%= addr.addressType %></span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2" onclick="openEditAddressModal('<%= addr._id %>', event)">Edit</button>
                                </div>
                                <div class="address-text">
                                    <p class="mb-1"><%= addr.addressLine %></p>
                                    <% if (addr.landmark) { %>
                                        <p class="mb-1 text-dark-50">Landmark: <%= addr.landmark %></p>
                                    <% } %>
                                    <p class="mb-2"><%= addr.city %>, <%= addr.state %> - <%= addr.pincode %></p>
                                    <p class="mb-0 text-dark fw-500" style="font-size: 0.88rem;"><i class="icon icon-phone me-1"></i> Phone: <%= addr.phone %></p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <div class="mt-4">
                        <button type="button" class="btn btn-brand-outline" data-bs-toggle="modal" data-bs-target="#checkoutAddressModal"><i class="icon icon-plus me-1"></i> Add Another Address</button>
                    </div>
                <% } %>
                <% if (addresses.length === 0) { %>
                    <div class="address-container mt-4" id="checkoutAddressList"></div>
                <% } %>
            </div>

            <div class="col-lg-5">
                <div class="summary-card">
                    <div class="checkout-step-title mb-4">
                        <span class="step-number">02</span>
                        <h4>Order Summary</h4>
                    </div>
                    
                    <div class="order-items-list mb-4">
                        <% items.forEach(item => { %>
                            <div class="d-flex justify-content-between align-items-center item-row">
                                <div class="pe-3">
                                    <h6 class="mb-1 text-truncate fw-semibold" style="max-width: 240px; font-family: var(--font-body); font-size: 0.95rem;"><%= item.product.title %></h6>
                                    <small class="text-muted">
                                        Qty: <%= item.quantity %> &times; ₹<%= item.pricing ? item.pricing.finalPrice : item.product.price %>
                                        <% if (item.pricing && item.pricing.discountPercentage > 0) { %>
                                            <span class="text-success">(<%= item.pricing.discountPercentage %>% off)</span>
                                        <% } %>
                                    </small>
                                </div>
                                <span class="fw-semibold text-dark fs-6">₹<%= item.itemTotal || (item.product.price * item.quantity) %></span>
                            </div>
                        <% }) %>
                    </div>

                    <div class="spacing-container" style="font-size: 0.95rem;">
                        <div class="d-flex justify-content-between mb-2.5">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-medium">₹<span id="cartSubtotalValue"><%= cartSubtotal %></span></span>
                        </div>
                        
                        <!-- Coupon Section -->
                        <div class="input-group mb-3 mt-3">
                            <input type="text" id="couponCode" class="form-control" placeholder="Enter Coupon Code">
                            <button class="btn btn-outline-dark" type="button" onclick="applyCoupon()">Apply</button>
                        </div>
                        <div class="d-flex justify-content-between mb-2 d-none" id="couponDiscountRow">
                            <span class="text-muted">Coupon Discount 
                                <button type="button" class="btn btn-sm text-danger p-0 ms-1" onclick="removeCoupon()">[Remove]</button>
                            </span>
                            <span class="text-success fw-medium" id="couponDiscountAmount">-₹0</span>
                        </div>
                        
                        <!-- Available Coupons Section -->
                        <% if (typeof coupons !== 'undefined' && coupons.length > 0) { %>
                            <div class="available-coupons mt-3 mb-3 p-3 bg-light border rounded">
                                <h6 class="mb-2 text-dark" style="font-size: 0.9rem;"><i class="icon icon-tag"></i> Available Coupons</h6>
                                <div class="d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                                    <% coupons.forEach(coupon => { %>
                                        <div class="coupon-item border p-2 rounded bg-white d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="d-block text-uppercase" style="font-size: 0.85rem;"><%= coupon.code %></strong>
                                                <small class="text-muted d-block" style="font-size: 0.75rem;">
                                                    <% if (coupon.discountType === 'flat') { %>
                                                        Flat ₹<%= coupon.discountValue %> OFF
                                                    <% } else { %>
                                                        <%= coupon.discountValue %>% OFF
                                                    <% } %>
                                                    <br>Min. Purchase: ₹<%= coupon.minPurchaseAmount %>
                                                </small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-dark" onclick="fillAndApplyCoupon('<%= coupon.code %>')" style="font-size: 0.75rem; padding: 4px 8px;">Apply</button>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Shipping</span>
                            <span class="text-success fw-medium">FREE</span>
                        </div>
                        <hr class="my-3" style="border-color: var(--brand-border);">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-semibold" style="font-family: var(--font-heading);">Grand Total</span>
                            <span class="fs-4 fw-bold" style="color: var(--brand-dark);" id="grandTotalValue">₹<%= cartSubtotal %></span>
                        </div>
                    </div>

                    <!-- Payment Method Selection -->
                    <div class="payment-methods mb-4">
                        <h6 class="mb-3">Payment Method</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="payOnline" value="Online" checked>
                            <label class="form-check-label" for="payOnline">
                                Pay Online (Razorpay)
                            </label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="payCOD" value="COD">
                            <label class="form-check-label" for="payCOD">
                                Cash on Delivery (COD)
                            </label>
                        </div>
                        
                        <!-- Wallet Section -->
                        <div class="wallet-section p-3 border rounded bg-light">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="useWalletCheckbox">
                                <label class="form-check-label d-flex justify-content-between w-100" for="useWalletCheckbox">
                                    <span>Use Wallet Balance</span>
                                    <!-- Assume walletBalance is passed. If not, it defaults to 0 in UI -->
                                    <span class="fw-bold text-success">₹<%= typeof walletBalance !== 'undefined' ? walletBalance : 0 %></span>
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1">Wallet cannot be used with COD.</small>
                        </div>
                    </div>

                    <% if (addresses.length > 0) { %>
                        <button id="placeOrderBtn" class="btn btn-brand-dark w-100 py-3 text-uppercase" onclick="placeOrder()">
                            Place Order
                        </button>
                    <% } else { %>
                        <button id="placeOrderBtn" class="btn btn-brand-dark w-100 py-3 text-uppercase opacity-50" disabled>
                            Add Address to Checkout
                        </button>
                    <% } %>
                    
                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="icon icon-shield-check"></i> Secure Checkout Experience</small>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="checkoutAddressModal" tabindex="-1" aria-labelledby="checkoutAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="checkoutAddressModalLabel">Add New Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="checkoutAddressForm" novalidate>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <input class="form-control" name="fullName" id="addFullName" placeholder="Enter full name">
                                <small class="text-danger d-block" id="addFullNameError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input class="form-control" name="phone" id="addPhone" placeholder="Enter phone number">
                                <small class="text-danger d-block" id="addPhoneError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">House / Flat / Building</label>
                                <input class="form-control" name="house" id="addHouse" placeholder="House no, apartment">
                                <small class="text-danger d-block" id="addHouseError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Area / Street</label>
                                <input class="form-control" name="area" id="addArea" placeholder="Street, area, colony">
                                <small class="text-danger d-block" id="addAreaError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Landmark <span class="text-muted">(optional)</span></label>
                                <input class="form-control" name="landmark" id="addLandmark" placeholder="e.g. Near City Mall">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input class="form-control" name="city" id="addCity" placeholder="City">
                                <small class="text-danger d-block" id="addCityError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">State</label>
                                <input class="form-control" name="state" id="addState" placeholder="State">
                                <small class="text-danger d-block" id="addStateError"></small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Pincode</label>
                                <input class="form-control" name="pincode" id="addPincode" placeholder="6-digit pincode">
                                <small class="text-danger d-block" id="addPincodeError"></small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" name="addressType" id="addAddressType">
                                    <option value="Home">Home</option>
                                    <option value="Office">Office</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-brand-dark">Save Address</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Address Modal -->
    <div class="modal fade" id="editCheckoutAddressModal" tabindex="-1" aria-labelledby="editCheckoutAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editCheckoutAddressModalLabel">Edit Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editCheckoutAddressForm" novalidate>
                    <input type="hidden" name="addressId" id="editAddressId">
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Full Name</label>
                                <input class="form-control" name="fullName" id="editFullName" placeholder="Enter full name">
                                <small class="text-danger d-block" id="editFullNameError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone Number</label>
                                <input class="form-control" name="phone" id="editPhone" placeholder="Enter phone number">
                                <small class="text-danger d-block" id="editPhoneError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">House / Flat / Building</label>
                                <input class="form-control" name="house" id="editHouse" placeholder="House no, apartment">
                                <small class="text-danger d-block" id="editHouseError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Area / Street</label>
                                <input class="form-control" name="area" id="editArea" placeholder="Street, area, colony">
                                <small class="text-danger d-block" id="editAreaError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Landmark <span class="text-muted">(optional)</span></label>
                                <input class="form-control" name="landmark" id="editLandmark" placeholder="e.g. Near City Mall">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">City</label>
                                <input class="form-control" name="city" id="editCity" placeholder="City">
                                <small class="text-danger d-block" id="editCityError"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">State</label>
                                <input class="form-control" name="state" id="editState" placeholder="State">
                                <small class="text-danger d-block" id="editStateError"></small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Pincode</label>
                                <input class="form-control" name="pincode" id="editPincode" placeholder="6-digit pincode">
                                <small class="text-danger d-block" id="editPincodeError"></small>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Type</label>
                                <select class="form-select" name="addressType" id="editAddressType">
                                    <option value="Home">Home</option>
                                    <option value="Office">Office</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-brand-dark">Update Address</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

<!-- Footer -->
	<footer id="footer" class="bg-dark text-white py-5 mt-5">
		<div class="container">
			<div class="row">
				<div class="col-md-4">
					<div class="footer-item">
						<div class="main-logo mb-3">
							<a href="/home"><img src="/images/main-logo.png" alt="logo" style="filter: brightness(0) invert(1);"></a>
						</div>
						<p>Explore thousands of books directly from our modern bookstore repository.</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="footer-item">
						<h4>Help & Info</h4>
						<ul class="list-unstyled">
							<li><a href="/help-center" class="text-white text-decoration-none">Help center</a></li>
							<li><a href="/contact-us" class="text-white text-decoration-none">Contact us</a></li>
						</ul>
					</div>
				</div>
				<div class="col-md-4">
					<div class="footer-item">
						<h4>Legal</h4>
						<p>© 2026 All rights reserved. Premium Booksaw Book Store.</p>
					</div>
				</div>
			</div>
		</div>
	</footer>

</body>
