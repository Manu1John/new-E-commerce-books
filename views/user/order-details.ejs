<%- include('../partials/header') %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<nav class="navbar navbar-expand-lg bg-white sticky-top shadow-sm py-3">
  <div class="container">
    <a class="navbar-brand" href="/home"><img src="/images/main-logo.png" alt="BookStore" height="36"></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#orderNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="orderNavbar">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/orders">My Orders</a></li>
        <li class="nav-item"><a class="nav-link" href="/cart">Cart</a></li>
      </ul>
      <a href="/orders/<%= order._id %>/invoice" class="btn btn-outline-dark btn-sm">Download Invoice</a>
    </div>
  </div>
</nav>

<main class="order-page container py-4 py-lg-5" data-order-id="<%= order._id %>">
  <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
    <div>
      <p class="text-uppercase text-muted small fw-bold mb-1">Order details</p>
      <h1 class="h3 mb-1">Order #<%= order.orderId %></h1>
      <p class="text-muted mb-0"><%= new Date(order.createdAt).toLocaleString() %></p>
    </div>
    <div class="d-flex align-items-start gap-2">
      <span class="status-pill"><%= order.displayStatus || order.status %></span>
      <span class="status-pill payment"><%= order.paymentStatus %></span>
    </div>
  </div>

  <div class="row g-4">
    <section class="col-lg-8">
      <div class="order-panel mb-4">
        <h2 class="section-title">Order Information</h2>
        <div class="info-grid">
          <div><span>Order ID</span><strong><%= order.orderId %></strong></div>
          <div><span>Order date</span><strong><%= new Date(order.createdAt).toLocaleDateString() %></strong></div>
          <div><span>Order status</span><strong id="overallOrderStatus"><%= order.displayStatus || order.status %></strong></div>
          <div><span>Payment method</span><strong><%= order.paymentMethod %></strong></div>
          <div><span>Payment status</span><strong><%= order.paymentStatus %></strong></div>
        </div>
      </div>

      <div class="order-panel mb-4">
        <h2 class="section-title">Customer Information</h2>
        <div class="row g-3">
          <div class="col-md-5">
            <div class="mini-label">Customer</div>
            <div class="fw-semibold"><%= user?.firstName || order.user?.firstName || '' %> <%= user?.lastName || order.user?.lastName || '' %></div>
            <div class="text-muted"><%= order.user?.email || user?.email || '' %></div>
          </div>
          <div class="col-md-7">
            <div class="mini-label">Shipping Address</div>
            <% if (order.shippingAddress) { %>
              <div class="fw-semibold"><%= order.shippingAddress.fullName %> (<%= order.shippingAddress.addressType %>)</div>
              <div><%= order.shippingAddress.addressLine %></div>
              <% if (order.shippingAddress.landmark) { %><div>Landmark: <%= order.shippingAddress.landmark %></div><% } %>
              <div><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %></div>
              <div class="text-muted">Phone: <%= order.shippingAddress.phone %></div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="order-panel">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <h2 class="section-title mb-0">Products</h2>
        </div>
        <div class="order-items">
          <% order.items.forEach((item) => { %>
            <article class="order-item" id="item-<%= item._id %>">
              <img src="<%= item.product?.images?.length ? '/uploads/' + item.product.images[0] : '/images/product-item1.jpg' %>" alt="<%= item.product?.title || 'Product' %>">
              <div class="item-body">
                <div class="d-flex justify-content-between gap-3">
                  <div>
                    <h3><%= item.product?.title || 'Unavailable product' %></h3>
                    <p class="text-muted mb-1">Qty: <%= item.quantity %></p>
                  </div>
                  <span class="item-status"><%= item.status %></span>
                </div>
                <div class="price-grid">
                  <div><span>Original</span><strong>₹<%= item.originalPrice %></strong></div>
                  <div><span>Discount %</span><strong><%= item.discountPercentage %>%</strong></div>
                  <div><span>Discount</span><strong>₹<%= item.discountAmount * item.quantity %></strong></div>
                  <div><span>Final</span><strong>₹<%= item.finalPrice %></strong></div>
                  <div><span>Subtotal</span><strong>₹<%= item.subtotal %></strong></div>
                </div>
                <% if (item.canCancel) { %>
                  <button class="btn btn-outline-danger btn-sm mt-3 cancel-item-btn" data-order-id="<%= order._id %>" data-item-id="<%= item._id %>">Cancel Item</button>
                <% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <aside class="col-lg-4">
      <!-- FIXED LINE: Added style="top: 85px; z-index: 10;" to prevent overlap with the sticky navbar -->
      <div class="order-panel sticky-lg-top summary-panel" style="top: 85px; z-index: 10;">
        <h2 class="section-title">Order Summary</h2>
        <div class="summary-row"><span>Subtotal</span><strong id="summarySubtotal">₹<%= order.money.subtotal %></strong></div>
        <div class="summary-row"><span>Total discount</span><strong id="summaryDiscount" class="text-success">-₹<%= order.money.totalDiscount %></strong></div>
        <div class="summary-row"><span>Shipping charge</span><strong>₹<%= order.money.shippingCharge %></strong></div>
        <hr>
        <div class="summary-row total"><span>Final total</span><strong id="summaryFinal">₹<%= order.money.finalTotal %></strong></div>

        <div class="tracking-box mt-4">
          <h3 class="h6 mb-3">Tracking</h3>
          <% order.items.forEach((item) => { %>
            <div class="track-line">
              <span><%= item.product?.title || 'Product' %></span>
              <strong><%= item.status %></strong>
            </div>
          <% }) %>
        </div>
      </div>
    </aside>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
<%- include('../partials/footer') %>