<%- include('../partials/header') %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">

<main class="order-success-page container py-5">
  <div class="success-card mx-auto">
    <div class="success-icon">✓</div>
    <p class="text-uppercase small fw-bold text-success mb-2">Order confirmed</p>
    <h1 class="h3 mb-3">Your order was placed successfully</h1>
    <p class="text-muted mb-4">Thanks for shopping with BookStore. We have received your order and will keep your tracking details updated.</p>

    <div class="success-details">
      <div><span>Order ID</span><strong><%= order.orderId %></strong></div>
      <div><span>Order date</span><strong><%= new Date(order.createdAt).toLocaleString() %></strong></div>
      <div><span>Total amount</span><strong>₹<%= order.money.finalTotal %></strong></div>
      <div><span>Payment method</span><strong><%= order.paymentMethod %></strong></div>
      <div><span>Payment status</span><strong><%= order.paymentStatus %></strong></div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
      <a class="btn btn-dark flex-fill" href="/orders/<%= order._id %>">View Order</a>
      <a class="btn btn-outline-dark flex-fill" href="/home">Continue Shopping</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
