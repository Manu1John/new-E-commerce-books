<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .success-icon { font-size: 80px; color: #28a745; margin-bottom: 20px; }
        .success-container { max-width: 500px; margin: 100px auto; text-align: center; padding: 40px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: #fff; }
    </style>
</head>
<body class="bg-light">
    <div class="success-container">
        <div class="success-icon">✓</div>
        <h2 class="mb-3">Order Confirmed!</h2>
        <p class="text-muted mb-4">Thank you for your purchase. Your payment was successful and your order is currently being processed.</p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="/orders" class="btn btn-outline-dark">View Order Details</a>
            <a href="/home" class="btn btn-dark">Continue Shopping</a>
        </div>
    </div>
</body>
</html>
