<%- include('../partials/header') %> <!-- Assuming there's a header partial, adjust if different -->

<main class="container my-5">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 bg-dark text-white rounded-4 p-4 text-center">
                <div class="my-4">
                    <h5 class="text-white-50 text-uppercase mb-2">Available Balance</h5>
                    <h1 class="display-4 fw-bold mb-0">₹<%= wallet.balance.toFixed(2) %></h1>
                </div>
                <button class="btn btn-light rounded-pill px-4 py-2 mt-3 fw-medium">Add Funds</button>
            </div>
        </div>

        <div class="col-lg-8">
            <h3 class="mb-4">Transaction History</h3>
            
            <% if (wallet.transactions.length === 0) { %>
                <div class="text-center py-5 border rounded bg-light">
                    <p class="text-muted mb-0">No transactions found in your wallet.</p>
                </div>
            <% } else { %>
                <div class="list-group list-group-flush shadow-sm rounded border">
                    <% wallet.transactions.forEach(txn => { %>
                        <div class="list-group-item p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><%= txn.description %></h6>
                                <small class="text-muted"><%= new Date(txn.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></small>
                            </div>
                            <div>
                                <% if (txn.type === 'credit') { %>
                                    <span class="fs-5 fw-bold text-success">+₹<%= txn.amount.toFixed(2) %></span>
                                <% } else { %>
                                    <span class="fs-5 fw-bold text-danger">-₹<%= txn.amount.toFixed(2) %></span>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
