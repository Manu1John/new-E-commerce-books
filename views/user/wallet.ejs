<%- include('../partials/header') %> 


    <main class="container">
        
        <section class="wallet-section">
            <h2 class="section-title">My Wallet</h2>
            <div class="wallet-grid">
                <div class="wallet-card">
                    <div class="wallet-value">$<%= wallet.balance.toFixed(2) %></div>
                    <div class="wallet-label">Available Balance</div>
                </div>
                <div class="wallet-card">
                    <div class="wallet-value">1200</div> 
                    <div class="wallet-label">Reward Points</div>
                </div>
                <div class="wallet-card">
                    <div class="wallet-value">03</div>
                    <div class="wallet-label">Saved Cards</div>
                </div>
            </div>
        </section>

        <!-- Linked Payment Methods -->
        <section class="list-section">
            <h3 class="section-subtitle">Linked Payment Methods</h3>
            <div class="list-container">
                <div class="list-item">
                    <span class="item-name">BookSaw Wallet Credit</span>
                    <span class="item-value">Active</span>
                </div>
            </div>
        </section>

        <!-- Dynamic Recent Transactions -->
        <section class="list-section">
            <h3 class="section-subtitle">Recent Transactions</h3>
            <div class="list-container">
                <% if (wallet.transactions && wallet.transactions.length > 0) { %>
                    <% wallet.transactions.forEach(transaction => { %>
                        <div class="list-item">
                            <span class="item-name"><%= transaction.description %></span>
                            <span class="item-value gold-text">
                                <%= transaction.type === 'credit' ? '+' : '-' %> $<%= transaction.amount.toFixed(2) %>
                            </span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="list-item">
                        <span class="item-name">No recent transactions</span>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- Action Buttons -->
        <div class="bottom-actions">
            <button class="btn btn-withdraw" onclick="openModal('withdrawModal')">Withdraw</button>
            <button class="btn btn-add" onclick="openModal('addMoneyModal')">Add Money</button>
        </div>

    </main>

    <!-- Add Money Modal -->
    <div id="addMoneyModal" class="modal">
        <!-- Modal Content ... -->
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('addMoneyModal')">&times;</span>
            <h2>Add Money</h2>
            <form action="/wallet/add-money" method="POST">
                <label for="addAmount">Amount ($):</label>
                <input type="number" id="addAmount" name="amount" min="1" step="0.01" required placeholder="Enter amount">
                <button type="submit" class="modal-submit-btn">Add to Wallet</button>
            </form>
        </div>
    </div>

    <!-- Withdraw Modal -->
    <div id="withdrawModal" class="modal">
        <!-- Modal Content ... -->
        <div class="modal-content">
            <span class="close-btn" onclick="closeModal('withdrawModal')">&times;</span>
            <h2>Withdraw Money</h2>
            <form action="/wallet/withdraw" method="POST">
                <label for="withdrawAmount">Amount ($):</label>
                <input type="number" id="withdrawAmount" name="amount" min="1" step="0.01" max="<%= wallet.balance %>" required placeholder="Enter amount">
                <button type="submit" class="modal-submit-btn">Withdraw</button>
            </form>
        </div>
    </div>

    <!-- Logic for Modals & Hamburger Menu -->
    <script>
        // Modal Logic
        function openModal(modalId) {
            document.getElementById(modalId).style.display = 'flex';
        }
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }
        window.onclick = function(event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = "none";
            }
        }

        // Hamburger Menu Logic
        document.addEventListener('DOMContentLoaded', () => {
            const hamburgerBtn = document.getElementById('hamburger-btn');
            const mainNav = document.getElementById('main-nav');
            const headerTools = document.getElementById('header-tools');
            
            if (hamburgerBtn && mainNav && headerTools) {
                hamburgerBtn.addEventListener('click', () => {
                    mainNav.classList.toggle('active');
                    headerTools.classList.toggle('active');
                    
                    const icon = hamburgerBtn.querySelector('i');
                    if (mainNav.classList.contains('active')) {
                        icon.classList.remove('fa-bars');
                        icon.classList.add('fa-times');
                    } else {
                        icon.classList.remove('fa-times');
                        icon.classList.add('fa-bars');
                    }
                });
            }
        });
    </script>

</body>
<%- include('../partials/footer') %>