<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= article.title %> - Booksaw</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"
		integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link rel="stylesheet" type="text/css" href="/icomoon/icomoon.css">
	<link rel="stylesheet" type="text/css" href="/css/index.css">
	<link rel="stylesheet" href="/css/navbar.css?v=3">
	<script defer src="/js/jquery-1.11.0.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
		integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
		crossorigin="anonymous"></script>
	<script defer src="/js/plugins.js"></script>
	<script defer src="/js/script.js"></script>
</head>

<body data-bs-spy="scroll" data-bs-target="#header" tabindex="0">
<%- include('../partials/navbar') %>

	<section class="py-5 my-5">
		<div class="container">
			<div class="row">
				<div class="col-md-8 mx-auto">
					
					<div class="mb-4">
						<a href="/" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-2"></i>Back to Home</a>
					</div>

					<div class="article-header mb-4">
						<h1 class="fw-bold mb-3"><%= article.title %></h1>
						<div class="text-muted mb-4">
							<i class="far fa-calendar-alt me-2"></i> <%= article.date %>
							<span class="mx-2">|</span>
							<i class="fas fa-folder-open me-2"></i> inspiration
						</div>
						<img src="<%= article.image %>" alt="<%= article.title %>" class="img-fluid rounded w-100 shadow-sm" style="max-height: 500px; object-fit: cover;">
					</div>

					<div class="article-content fs-5" style="line-height: 1.8;">
						<%- article.content %>
					</div>

					<hr class="my-5">

					<div class="d-flex justify-content-between align-items-center">
						<h5 class="m-0">Share this article:</h5>
						<div>
							<a href="#" class="btn btn-outline-dark rounded-circle me-2"><i class="fab fa-facebook-f"></i></a>
							<a href="#" class="btn btn-outline-dark rounded-circle me-2"><i class="fab fa-twitter"></i></a>
							<a href="#" class="btn btn-outline-dark rounded-circle"><i class="fab fa-linkedin-in"></i></a>
						</div>
					</div>

				</div>
			</div>
		</div>
	</section>

	<footer id="footer" class="bg-dark text-white py-5 mt-5">
		<div class="container">
			<div class="row">
				<div class="col-md-4">
					<div class="footer-item">
						<div class="main-logo mb-3">
							<a href="/home"><img src="/images/main-logo.png" alt="logo" style="filter: brightness(0) invert(1);"></a>
						</div>
						<p>Explore thousands of books directly from our modern bookstore repository.</p>
					</div>
				</div>
				<div class="col-md-4">
					<div class="footer-item">
						<h4>Help & Info</h4>
						<ul class="list-unstyled">
							<li><a href="/help-center" class="text-white text-decoration-none">Help center</a></li>
							<li><a href="/contact-us" class="text-white text-decoration-none">Contact us</a></li>
						</ul>
					</div>
				</div>
				<div class="col-md-4">
					<div class="footer-item">
						<h4>Legal</h4>
						<p>© 2026 All rights reserved. Premium Booksaw Book Store.</p>
					</div>
				</div>
			</div>
		</div>
	</footer>

</body>
</html>
