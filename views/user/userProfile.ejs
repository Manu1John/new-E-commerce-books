<%- include('../partials/header') %>

<% if (!user.googleId) { %>
<!-- PROFILE SECTION -->
<section class="profile-section">
    <h1 class="page-title">MY PROFILE</h1>
    <div class="profile-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="profile-card">
                <img src="<%= user.profileImage || 'https://i.pravatar.cc/150' %>" alt="profile" />
                <h3><%= user.firstName %> <%= user.lastName %></h3>
            </div>
            <button>Profile Overview</button>
            <a href="/orders"><button>My Orders</button></a>
            <a href="/wishlist"><button>Wishlist</button></a>
            <a href="/wallet"><button>Wallet</button></a>
            <a href="/address"><button>Address</button></a>
            <form action="/logout" method="POST">
                <button type="submit">Logout</button>
            </form>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="profile-content">
            <!-- STATS -->
            <div class="stats-box">
                <div class="stat"><h2><%= String(typeof booksOrdered !== 'undefined' ? booksOrdered : 0).padStart(2, '0') %></h2><p>Books Ordered</p></div>
                <div class="stat"><h2><%= String(typeof wishlistItems !== 'undefined' ? wishlistItems : 0).padStart(2, '0') %></h2><p>Wishlist Items</p></div>
                <div class="stat"><h2><%= String(typeof reviewsPosted !== 'undefined' ? reviewsPosted : 0).padStart(2, '0') %></h2><p>Reviews Posted</p></div>
            </div>

            <!-- PERSONAL INFO -->
            <form action="/profile/update?_method=PUT" method="POST" enctype="multipart/form-data" class="info-card">
                <h2>Personal Information</h2>
                <!-- Profile Upload -->
                <div class="profile-upload">
                    <img id="previewImage" src="<%= user.profileImage || 'https://i.pravatar.cc/150' %>" alt="profile" class="profile-preview" />
                    <input type="file" name="profileImage" id="profileImage" hidden />
                    <button type="button" id="changePhotoBtn" class="change-photo-btn">Change Photo</button>
                </div>

                <div class="form-grid">
                    <!-- First Name -->
                    <div>
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName" value="<%= user.firstName %>" maxlength="30" autocomplete="given-name" disabled />
                        <small id="firstNameError" class="text-danger"></small>
                    </div>
                    <!-- Last Name -->
                    <div>
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName" value="<%= user.lastName %>" maxlength="30" autocomplete="family-name" disabled />
                        <small id="lastNameError" class="text-danger"></small>
                    </div>
                    <!-- Email -->
                    <div>
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" value="<%= user.email %>" disabled />
                        <small id="emailError" class="text-danger"></small>
                    </div>
                    <!-- Phone -->
                    <div>
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>" maxlength="10" autocomplete="tel" disabled />
                        <small id="phoneError" class="text-danger"></small>
                    </div>
                </div>
                <button type="button" class="save-btn" id="editBtn">Edit</button>
            </form>

            <!-- PASSWORD & EMAIL -->
            <div class="bottom-grid">
                <!-- PASSWORD -->
                <div class="card">
                    <div class="card-header">
                        <h2>Change Password</h2>
                        <button type="button" id="togglePasswordBtn" class="toggle-btn">Change Password</button>
                    </div>
                    <!-- HIDDEN PASSWORD FORM -->
                    <div id="passwordFormContainer" style="display:<%= (typeof error !== 'undefined' && error) || (typeof success !== 'undefined' && success) ? 'block' : 'none' %>;">
                        <% if (typeof error !== "undefined" && error) { %><p class="error-msg"><%= error %></p><% } %>
                        <% if (typeof success !== "undefined" && success) { %><p class="success-msg"><%= success %></p><% } %>
                        
                        <form action="/change-password?_method=PATCH" method="POST" id="changePasswordForm">
                            <input type="password" name="currentPassword" id="currentPassword" placeholder="Current password" required />
                            <div class="two-col">
                                <div>
                                    <input type="password" name="newPassword" id="newPassword" placeholder="New password" required />
                                    <small class="text-danger" id="newPasswordError"></small>
                                </div>
                                <div>
                                    <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm password" required />
                                    <small class="text-danger" id="confirmPasswordError"></small>
                                </div>
                            </div>
                            <!-- SHOW PASSWORD -->
                            <div class="show-password-container" style="margin:10px 0; display:flex; align-items:center; gap:8px;">
                                <i class="fa-solid fa-eye-slash" id="passwordShow"></i>
                                <label>Show Passwords</label>
                            </div>
                            <!-- PASSWORD RULES -->
                            <div class="password-rules">
                                <p>Password must contain:</p>
                                <ul>
                                    <li id="lengthRule" class="invalid">❌ At least 8 characters</li>
                                    <li id="upperRule" class="invalid">❌ One uppercase letter</li>
                                    <li id="lowerRule" class="invalid">❌ One lowercase letter</li>
                                    <li id="numberRule" class="invalid">❌ One number</li>
                                    <li id="specialRule" class="invalid">❌ One special character</li>
                                </ul>
                            </div>
                            <button type="submit" id="passwordBtn">UPDATE PASSWORD</button>
                        </form>
                    </div>
                </div>

                <!-- EMAIL -->
                <div class="card">
                    <div class="card-header">
                        <h2>Change Email</h2>
                        <button type="button" id="toggleEmailBtn" class="toggle-btn">Change Email</button>
                    </div>
                    <!-- HIDDEN EMAIL FORM -->
                    <div id="emailFormContainer" style="display:<%= (typeof emailError !== 'undefined' && emailError) || (typeof emailSuccess !== 'undefined' && emailSuccess) ? 'block' : 'none' %>;">
                        <% if (typeof emailError !== "undefined" && emailError) { %><p class="error-msg"><%= emailError %></p><% } %>
                        <% if (typeof emailSuccess !== "undefined" && emailSuccess) { %><p class="success-msg"><%= emailSuccess %></p><% } %>
                        <!-- SEND OTP -->
                        <form action="/send-email-otp" method="POST">
                            <input type="email" value="<%= user.email %>" disabled />
                            <input type="email" name="newEmail" placeholder="New email" required />
                            <input type="password" name="password" placeholder="Current password" required />
                            <button type="submit">Send OTP</button>
                        </form>
                        <!-- VERIFY OTP -->
                        <form action="/verify-email-otp?_method=PATCH" method="POST">
                            <input type="text" name="otp" placeholder="Enter OTP" required />
                            <button type="submit">Verify & Update Email</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<%}else{%>
<!-- PROFILE SECTION -->
<section class="profile-section">
    <h1 class="page-title">MY PROFILE</h1>
    <div class="profile-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="profile-card">
                <img src="<%= user.profileImage || 'https://i.pravatar.cc/150' %>" alt="profile" />
                <h3><%= user.firstName %> <%= user.lastName %></h3>
            </div>
            <button>Profile Overview</button>
            <a href="/orders"><button>My Orders</button></a> 
            <a href="/wishlist"><button>Wishlist</button></a>
            <a href="/wallet"><button>Wallet</button></a>
            <a href="/address"><button>Address</button></a>
            <form action="/logout" method="POST">
                <button type="submit">Logout</button>
            </form>
        </aside>

        <!-- MAIN CONTENT -->
        <div class="profile-content">
            <!-- STATS -->
            <div class="stats-box">
                <div class="stat"><h2><%= String(typeof booksOrdered !== 'undefined' ? booksOrdered : 0).padStart(2, '0') %></h2><p>Books Ordered</p></div>
                <div class="stat"><h2><%= String(typeof wishlistItems !== 'undefined' ? wishlistItems : 0).padStart(2, '0') %></h2><p>Wishlist Items</p></div>
                <div class="stat"><h2><%= String(typeof reviewsPosted !== 'undefined' ? reviewsPosted : 0).padStart(2, '0') %></h2><p>Reviews Posted</p></div>
            </div>

            <!-- PERSONAL INFO -->
            <form action="/profile/update?_method=PUT" method="POST" enctype="multipart/form-data" class="info-card">
                <h2>Personal Information</h2>
                <div class="profile-upload">
                    <img id="previewImage" src="<%= user.profileImage || 'https://i.pravatar.cc/150' %>" alt="profile" class="profile-preview" />
                    <input type="file" name="profileImage" id="profileImage" hidden />
                    <button type="button" id="changePhotoBtn" class="change-photo-btn">Change Photo</button>
                </div>
                <div class="form-grid">
                    <div>
                        <label for="firstName">First Name</label>
                        <input type="text" id="firstName" name="firstName" value="<%= user.firstName %>" maxlength="30" autocomplete="given-name" disabled />
                        <small id="firstNameError" class="text-danger"></small>
                    </div>
                    <div>
                        <label for="lastName">Last Name</label>
                        <input type="text" id="lastName" name="lastName" value="<%= user.lastName %>" maxlength="30" autocomplete="family-name" disabled />
                        <small id="lastNameError" class="text-danger"></small>
                    </div>
                    <div>
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" value="<%= user.email %>" disabled />
                        <small id="emailError" class="text-danger"></small>
                    </div>
                    <div>
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>" maxlength="10" autocomplete="tel" disabled />
                        <small id="phoneError" class="text-danger"></small>
                    </div>
                </div>
                <button type="button" class="save-btn" id="editBtn">Edit</button>
            </form>

            <!-- REFERRAL INFO -->
            <% if (user.referralCode) { %>
            <div class="info-card" style="margin-top: 2rem; padding: 25px; background-color: #fff; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);">
                <h2 style="margin-bottom: 10px; font-size: 1.5rem; color: #333;">Referral Program</h2>
                <p class="text-muted" style="margin-bottom: 20px;">Share your unique code with friends. When they sign up, you both earn a wallet bonus!</p>
                <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
                    <input type="text" id="myReferralCode" value="<%= user.referralCode %>" disabled style="padding: 12px; border: 2px dashed #007bff; background: #f8f9fa; border-radius: 6px; font-weight: bold; font-size: 1.1rem; width: 220px; text-align: center; color: #007bff;" />
                    <button type="button" class="save-btn" onclick="copyReferral(false)" style="margin: 0; padding: 12px 20px; background: #007bff;">
                        <i class="fa-regular fa-copy" style="margin-right: 5px;"></i> Copy Code
                    </button>
                    <button type="button" class="save-btn" onclick="copyReferral(true)" style="margin: 0; padding: 12px 20px; background: #28a745;">
                        <i class="fa-solid fa-link" style="margin-right: 5px;"></i> Copy Link
                    </button>
                </div>
            </div>
            <script>
                function copyReferral(isLink) {
                    const code = document.getElementById("myReferralCode").value;
                    let copyText = code;
                    
                    if (isLink) {
                        const baseUrl = window.location.origin;
                        copyText = `${baseUrl}/signup?ref=${code}`;
                    }
                    
                    const fallbackCopy = () => {
                        const tempInput = document.createElement("input");
                        tempInput.value = copyText;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        tempInput.setSelectionRange(0, 99999);
                        try {
                            document.execCommand('copy');
                            const msg = isLink ? 'Referral link copied!' : 'Referral code copied!';
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({ icon: 'success', title: 'Copied!', text: msg, timer: 1500, showConfirmButton: false });
                            } else {
                                alert(msg);
                            }
                        } catch (err) {
                            console.error('Fallback: Oops, unable to copy', err);
                        }
                        document.body.removeChild(tempInput);
                        window.getSelection().removeAllRanges();
                    };

                    if (navigator.clipboard && window.isSecureContext) {
                        navigator.clipboard.writeText(copyText).then(() => {
                            const msg = isLink ? 'Referral link copied!' : 'Referral code copied!';
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({ icon: 'success', title: 'Copied!', text: msg, timer: 1500, showConfirmButton: false });
                            } else {
                                alert(msg);
                            }
                        }).catch(err => {
                            console.error('Failed to copy using clipboard API', err);
                            fallbackCopy();
                        });
                    } else {
                        fallbackCopy();
                    }
                }
            </script>
            <% } %>

        </div>
    </div>
</section>
<%}%>

<%- include('../partials/footer') %>

<script>
    // Toggle Script for Mobile Navigation
    document.addEventListener("DOMContentLoaded", () => {
        const hamburger = document.getElementById('hamburger-menu') || document.getElementById('hamburger-menu-google');
        const navLinks = document.getElementById('nav-links') || document.getElementById('nav-links-google');

        if (hamburger && navLinks) {
            hamburger.addEventListener('click', () => {
                navLinks.classList.toggle('active');
            });
        }
    });
</script>
